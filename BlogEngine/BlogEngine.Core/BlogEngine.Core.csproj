<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BlogEngine.Core</RootNamespace>
    <AssemblyName>BlogEngine.Core</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- From the original Properties/AssemblyInfo.cs; BlogSettings.Version reads the assembly version -->
    <Version>3.3.8.0</Version>
    <Product>BlogEngine.NET</Product>
    <Description>BlogEngine.NET</Description>
    <Copyright>Copyright @ 2007-2019</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.CLSCompliantAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.3" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="NUglify" Version="1.21.18" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NuGet.Protocol" Version="6.14.3" />
    <PackageReference Include="System.ServiceModel.Syndication" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- BlogML.dll: .NET Framework assembly used for BlogML import/export.
         This is a local reference to the original DLL. If it fails at runtime on net10.0,
         the BlogML types (BlogMLBlog, BlogMLPost, BlogMLSerializer) in
         Services/Syndication/BlogML/ will need to be inlined or replaced. -->
    <Reference Include="BlogML">
      <HintPath>..\..\lib\blogml\BlogML.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
