<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BlogEngine.NET</RootNamespace>
    <AssemblyName>BlogEngine.NET</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.12" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlogEngine.Core\BlogEngine.Core.csproj" />
  </ItemGroup>

  <!-- Exclude legacy WebPages .cshtml files from Razor compilation.
       These are widget templates and RazorHost theme templates that use WebPages
       syntax (RenderPage, Request, Resources.labels, IsPost, Validator) which is not
       compatible with ASP.NET Core Razor compilation. They are served as content files.
       (The admin/*.cshtml shell pages are ASP.NET Core Razor Pages and are compiled.) -->
  <ItemGroup>
    <Content Remove="Custom\**\*.cshtml" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Custom\**\*.cshtml" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Runtime data and theme/widget folders live under the content root (read and written by BlogEngine.Core) -->
  <ItemGroup>
    <None Update="App_Data\**;Custom\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
