<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BlogEngine.NET</RootNamespace>
    <AssemblyName>BlogEngine.NET</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.*" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlogEngine.Core\BlogEngine.Core.csproj" />
  </ItemGroup>

  <!-- Exclude legacy WebPages .cshtml files from Razor compilation.
       These are admin SPA layout templates, widget templates, and RazorHost
       theme templates that use WebPages syntax (RenderPage, Request,
       Resources.labels, IsPost, Validator) which is not compatible with
       ASP.NET Core Razor compilation. They are served as content files. -->
  <ItemGroup>
    <Content Remove="admin\**\*.cshtml" />
    <Content Remove="Custom\**\*.cshtml" />
  </ItemGroup>
  <ItemGroup>
    <None Include="admin\**\*.cshtml" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Custom\**\*.cshtml" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
