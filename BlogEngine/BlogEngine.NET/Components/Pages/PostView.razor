@page "/post.aspx"
@page "/post/{Slug}"
@page "/post/{Year:int}/{Month:int}/{Slug}"
@page "/post/{Year:int}/{Month:int}/{Day:int}/{Slug}"
@using BlogEngine.Core.Web.Controls
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Caching.Memory.IMemoryCache MemoryCache

@* Port of post.aspx (+ UrlRules.RewritePost for the /post/{slug} URLs) *@

@if (post != null)
{
    <BlogHead Title="@post.Title" Description="@BlogHead.MetaDescription(post.Description)" Keywords="@keywords"
              Author="@(post.AuthorProfile == null ? post.Author : post.AuthorProfile.FullName)">
        @if (firstPost != null)
        {
            <link rel="last" title="@lastPost.Title" href="@lastPost.RelativeLink" />
            <link rel="first" title="@firstPost.Title" href="@firstPost.RelativeLink" />
        }
        <link type="application/rss+xml" rel="alternate" title="@post.Title (RSS)" href="@(postView.CommentFeed)?format=ATOM" />
        <link type="application/rss+xml" rel="alternate" title="@post.Title (ATOM)" href="@(postView.CommentFeed)?format=ATOM" />
        @if (ShowFacebookComments)
        {
            <meta property="fb:app_id" content="@BlogSettings.Instance.FacebookAppId" />
        }
    </BlogHead>

    @if (showUnsubscribed)
    {
        <div id="commentNotificationUnsubscription">
            <h1>@Utils.Translate("commentNotificationUnsubscriptionHeader")</h1>
            <div>@Utils.Translate("commentNotificationUnsubscriptionText")</div>
        </div>
    }

    @if (navigation != null)
    {
        <DynamicComponent Type="@Theme.Template("PostNavigation")" Parameters="@(new Dictionary<string, object> { ["View"] = navigation })" />
    }

    <DynamicComponent Type="@Theme.Template("PostView")" Parameters="@(new Dictionary<string, object> { ["View"] = postView })" />

    @if (BlogSettings.Instance.EnableRelatedPosts)
    {
        var relatedTemplate = Theme.Template("RelatedPosts");
        if (relatedTemplate != null)
        {
            <DynamicComponent Type="@relatedTemplate" Parameters="@(new Dictionary<string, object> { ["View"] = new RelatedPostsBase(MemoryCache) { PostItem = post } })" />
        }
        else
        {
            <RelatedPosts Item="@post" MaxResults="3" ShowDescription="true" DescriptionMaxLength="100" />
        }
    }

    @if (BlogSettings.Instance.EnableTrackBackReceive)
    {
        @((MarkupString)$"<rdf:RDF xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\" xmlns:trackback=\"http://madskills.com/public/xml/rss/module/trackback/\">\n      <rdf:Description rdf:about=\"{post.AbsoluteLink}\" dc:identifier=\"{post.AbsoluteLink}\" dc:title=\"{post.Title}\" trackback:ping=\"{post.TrackbackLink}\" />\n    </rdf:RDF>")
    }

    @if (ShowBlogengineComments)
    {
        <CommentList Post="@post" />
    }

    @if (ShowDisqusComments)
    {
        <div id="comment" class="comment-form well-global">
            <div id="disqus_thread" class="form-horizontal"></div>
        </div>
        <script type="text/javascript">
            var disqus_url = '@post.PermaLink';
            var disqus_developer = '@(BlogSettings.Instance.DisqusDevMode ? 1 : 0)';
            (function() {
                var dsq = document.createElement('script'); dsq.type = 'text/javascript'; dsq.async = true;
                dsq.src = '@(HttpContext.Request.Scheme)://@(BlogSettings.Instance.DisqusWebsiteName).disqus.com/embed.js';
                (document.getElementsByTagName('head')[0] || document.getElementsByTagName('body')[0]).appendChild(dsq);
            })();
        </script>
    }

    @if (ShowFacebookComments)
    {
        <div id="comment" class="comment-form well-global">
            <div class="form-horizontal">
                <div class="fb-comments" data-href="@post.PermaLink" data-version="v2.4" data-width="100%"></div>
            </div>
        </div>
        <div id="fb-root"></div>
        <script>(function(d, s, id) {
          var js, fjs = d.getElementsByTagName(s)[0];
          if (d.getElementById(id)) return;
          js = d.createElement(s); js.id = id;
          js.src = "//connect.facebook.net/@(BlogSettings.Instance.FacebookLanguage)/sdk.js#xfbml=1&version=v2.4";
          fjs.parentNode.insertBefore(js, fjs);
        }(document, 'script', 'facebook-jssdk'));</script>
    }
}

@code {
    [CascadingParameter] public HttpContext HttpContext { get; set; }

    [Parameter] public string Slug { get; set; }
    [Parameter] public int? Year { get; set; }
    [Parameter] public int? Month { get; set; }
    [Parameter] public int? Day { get; set; }

    [SupplyParameterFromQuery(Name = "id")] public string QueryId { get; set; }
    [SupplyParameterFromQuery(Name = "unsubscribe-email")] public string UnsubscribeEmail { get; set; }
    [SupplyParameterFromQuery(Name = "deletepost")] public string DeletePostId { get; set; }

    public static bool ShowBlogengineComments => BlogSettings.Instance.CommentProvider == BlogSettings.CommentsBy.BlogEngine;
    public static bool ShowDisqusComments => BlogSettings.Instance.CommentProvider == BlogSettings.CommentsBy.Disqus;
    public static bool ShowFacebookComments => BlogSettings.Instance.CommentProvider == BlogSettings.CommentsBy.Facebook;

    private Post post;
    private PostViewBase postView;
    private PostNavigationBase navigation;
    private Post firstPost;
    private Post lastPost;
    private string keywords;
    private bool showUnsubscribed;

    protected override void OnParametersSet()
    {
        if (!Security.IsAuthorizedTo(Rights.ViewPublicPosts))
        {
            Navigation.NavigateTo(Utils.RelativeWebRoot);
            return;
        }

        if (HandleDeletePost())
        {
            return;
        }

        var found = Slug != null ? FindBySlug() : FindById();
        if (found == null)
        {
            Navigation.NotFound();
            return;
        }

        var rawPath = Utils.GetRequestPath(HttpContext);
        if (Slug == null && HttpContext.Request.QueryString.Value?.Contains("id=") == true)
        {
            // post.aspx?id= : 301 to the permalink unless several posts share the same link
            if (Post.Posts.FindAll(p => p.RelativeLink.Equals(found.RelativeLink)).Count < 2)
            {
                HttpContext.Response.Redirect(found.RelativeLink, permanent: true);
                return;
            }
        }

        if (!found.IsVisible)
        {
            Navigation.NavigateTo(Utils.RelativeWebRoot);
            return;
        }

        if (Slug != null && !string.Equals(rawPath, found.RelativeLink, StringComparison.Ordinal))
        {
            // SEO redirect to the canonical post URL (e.g. different casing or old .aspx extension)
            HttpContext.Response.Redirect(found.RelativeLink + HttpContext.Request.QueryString, permanent: true);
            return;
        }

        LoadPost(found);
    }

    private Post FindById()
    {
        return Guid.TryParse(QueryId, out var id) ? Post.ApplicablePosts.Find(p => p.Id == id) : null;
    }

    private Post FindBySlug()
    {
        var slug = Slug.EndsWith(".aspx", StringComparison.OrdinalIgnoreCase) ? Slug.Substring(0, Slug.Length - 5) : Slug;
        var haveDate = BlogSettings.Instance.TimeStampPostLinks && Year.HasValue && Month.HasValue;

        return Post.ApplicablePosts.Find(p =>
            (!haveDate || (p.DateCreated.Year == Year && p.DateCreated.Month == Month)) &&
            (!haveDate || !Day.HasValue || p.DateCreated.Day == Day) &&
            slug.Equals(Utils.RemoveIllegalCharacters(p.Slug), StringComparison.OrdinalIgnoreCase));
    }

    private void LoadPost(Post found)
    {
        post = found;
        postView = new PostViewBase
        {
            Post = post,
            Location = ServingLocation.SinglePost,
            RequestUrl = Utils.GetRawUrl(HttpContext)
        };

        if (post.Tags.Count > 0)
        {
            keywords = string.Join(",", post.Tags);
        }

        var visiblePosts = Post.Posts.FindAll(p => p.IsVisible);
        if (visiblePosts.Count > 0)
        {
            lastPost = visiblePosts[0];
            firstPost = visiblePosts[visiblePosts.Count - 1];
        }

        InitNavigationLinks();

        if (BlogSettings.Instance.EnablePingBackReceive)
        {
            HttpContext.Response.Headers["x-pingback"] = $"http://{HttpContext.Request.Host}{Utils.RelativeWebRoot}pingback.axd";
        }

        if (!string.IsNullOrEmpty(UnsubscribeEmail) && post.NotificationEmails.Contains(UnsubscribeEmail))
        {
            post.NotificationEmails.Remove(UnsubscribeEmail);
            post.Save();
            showUnsubscribed = true;
        }
    }

    private void InitNavigationLinks()
    {
        if (!BlogSettings.Instance.ShowPostNavigation)
        {
            return;
        }

        var view = new PostNavigationBase { CurrentPost = post };
        if (!string.IsNullOrEmpty(view.NextPostUrl) || !string.IsNullOrEmpty(view.PreviousPostUrl))
        {
            navigation = view;
        }
    }

    /// <summary>
    /// ?deletepost={id} from the admin links of the post view (BlogBasePage.OnPreInit).
    /// </summary>
    private bool HandleDeletePost()
    {
        if (string.IsNullOrEmpty(DeletePostId) || !Guid.TryParse(DeletePostId, out var id))
        {
            return false;
        }

        var toDelete = Post.GetPost(id);
        if (toDelete == null || !toDelete.CanUserDelete)
        {
            return false;
        }

        toDelete.Delete();
        toDelete.Save();
        Navigation.NavigateTo(Utils.RelativeWebRoot);
        return true;
    }
}
