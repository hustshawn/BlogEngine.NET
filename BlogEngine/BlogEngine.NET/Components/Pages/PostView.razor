@page "/post"
@page "/post/{Slug}"
@using System.Web
@using BlogEngine.Core
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@pageTitle</PageTitle>

@if (shouldShow404)
{
    <div class="error-404">
        <h1>Post not found</h1>
        <p>The requested post could not be found.</p>
    </div>
}
else if (CurrentPost != null)
{
    @if (showCommentUnsubscription)
    {
        <div id="commentNotificationUnsubscription">
            <h1>@Utils.Translate("commentNotificationUnsubscriptionHeader")</h1>
            <div>@Utils.Translate("commentNotificationUnsubscriptionText")</div>
        </div>
    }

    @if (showPostNavigation && (nextPost != null || prevPost != null))
    {
        <div class="post-navigation">
            @if (prevPost != null)
            {
                <a href="@prevPost.RelativeLink" class="nav-prev">← @prevPost.Title</a>
            }
            @if (nextPost != null)
            {
                <a href="@nextPost.RelativeLink" class="nav-next">@nextPost.Title →</a>
            }
        </div>
    }

    <div class="post-view" id="@CurrentPost.Id.ToString().Replace("-", "")">
        <h1 class="post-title">
            <a href="@CurrentPost.RelativeLink">@CurrentPost.Title</a>
        </h1>
        <div class="post-info">
            <span class="post-date">@CurrentPost.DateCreated.ToString("MMMM d, yyyy HH:mm")</span>
            <span class="post-author"> by @(CurrentPost.AuthorProfile != null ? CurrentPost.AuthorProfile.FullName : CurrentPost.Author)</span>
        </div>
        @if (CurrentPost.Categories.Count > 0)
        {
            <div class="post-categories">
                @Utils.Translate("postedIn"):
                @foreach (var cat in CurrentPost.Categories)
                {
                    <a href="@cat.RelativeLink">@cat.Title</a>
                }
            </div>
        }
        @if (CurrentPost.Tags.Count > 0)
        {
            <div class="post-tags">
                @Utils.Translate("tags"):
                @foreach (var tag in CurrentPost.Tags)
                {
                    <a href="@(Utils.RelativeWebRoot + "?tag=/" + HttpUtility.UrlEncode(tag))">@tag</a>
                }
            </div>
        }
        <div class="post-body">
            @((MarkupString)CurrentPost.Content)
        </div>
    </div>

    @if (BlogSettings.Instance.EnableRelatedPosts)
    {
        <div class="related-posts">
            <h3>@Utils.Translate("relatedPosts")</h3>
            @* Related posts rendered inline *@
        </div>
    }

    @if (BlogSettings.Instance.EnableTrackBackReceive)
    {
        <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
                 xmlns:dc="http://purl.org/dc/elements/1.1/"
                 xmlns:trackback="http://madskills.com/public/xml/rss/module/trackback/">
            <rdf:Description rdf:about="@CurrentPost.AbsoluteLink"
                             dc:identifier="@CurrentPost.AbsoluteLink"
                             dc:title="@CurrentPost.Title"
                             trackback:ping="@CurrentPost.TrackbackLink" />
        </rdf:RDF>
    }

    @if (ShowBlogengineComments)
    {
        <div id="comment-list">
            @if (CurrentPost.Comments != null)
            {
                <h3>@CurrentPost.ApprovedComments.Count @Utils.Translate("comments")</h3>
                @foreach (var comment in CurrentPost.ApprovedComments)
                {
                    <div class="comment" id="comment-@comment.Id">
                        <div class="comment-author">
                            @if (!string.IsNullOrEmpty(comment.Website?.ToString()))
                            {
                                <a href="@comment.Website" rel="nofollow">@comment.Author</a>
                            }
                            else
                            {
                                @comment.Author
                            }
                        </div>
                        <div class="comment-date">@comment.DateCreated.ToString("MMMM d, yyyy HH:mm")</div>
                        <div class="comment-body">@((MarkupString)comment.Content)</div>
                    </div>
                }
            }
        </div>
    }

    @if (ShowDisqusComments)
    {
        <div id="comment" class="comment-form well-global">
            <div id="disqus_thread" class="form-horizontal"></div>
        </div>
        <script>
            var disqus_url = '@CurrentPost.PermaLink';
            var disqus_developer = '@(BlogSettings.Instance.DisqusDevMode ? 1 : 0)';
            (function () {
                var dsq = document.createElement('script'); dsq.type = 'text/javascript'; dsq.async = true;
                dsq.src = '//@(BlogSettings.Instance.DisqusWebsiteName).disqus.com/embed.js';
                (document.getElementsByTagName('head')[0] || document.getElementsByTagName('body')[0]).appendChild(dsq);
            })();
        </script>
    }

    @if (ShowFacebookComments)
    {
        <div id="comment" class="comment-form well-global">
            <div class="form-horizontal">
                <div class="fb-comments" data-href="@CurrentPost.PermaLink" data-version="v2.4" data-width="100%"></div>
            </div>
        </div>
        <div id="fb-root"></div>
        <script>
            (function (d, s, id) {
                var js, fjs = d.getElementsByTagName(s)[0];
                if (d.getElementById(id)) return;
                js = d.createElement(s); js.id = id;
                js.src = "//connect.facebook.net/@(BlogSettings.Instance.FacebookLanguage)/sdk.js#xfbml=1&version=v2.4";
                fjs.parentNode.insertBefore(js, fjs);
            }(document, 'script', 'facebook-jssdk'));
        </script>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "id")]
    public string QueryId { get; set; }

    [SupplyParameterFromQuery(Name = "unsubscribe-email")]
    public string UnsubscribeEmail { get; set; }

    [Parameter]
    public string Slug { get; set; }

    public Post CurrentPost { get; set; }

    private string pageTitle = string.Empty;
    private bool shouldShow404 = false;
    private bool showCommentUnsubscription = false;
    private bool showPostNavigation = false;
    private Post nextPost;
    private Post prevPost;

    public static bool ShowBlogengineComments =>
        BlogSettings.Instance.CommentProvider == BlogSettings.CommentsBy.BlogEngine;

    public static bool ShowDisqusComments =>
        BlogSettings.Instance.CommentProvider == BlogSettings.CommentsBy.Disqus;

    public static bool ShowFacebookComments =>
        BlogSettings.Instance.CommentProvider == BlogSettings.CommentsBy.Facebook;

    protected override void OnInitialized()
    {
        if (!Security.IsAuthorizedTo(Rights.ViewPublicPosts))
        {
            Navigation.NavigateTo(Utils.RelativeWebRoot, false, true);
            return;
        }

        var httpContext = HttpContextAccessor.HttpContext;
        var rawUrl = httpContext?.Request.Path.Value ?? string.Empty;

        Guid id;
        bool shouldThrow404Local = false;

        if (!string.IsNullOrWhiteSpace(QueryId) && Guid.TryParse(QueryId, out id))
        {
            Post post = Post.ApplicablePosts.Find(p => p.Id == id);

            if (post != null)
            {
                // If accessed via ?id= query string, do a 301 redirect to the clean URL
                if (httpContext?.Request.QueryString.Value?.Contains("id=") == true)
                {
                    // Only redirect if there aren't multiple posts with the same RelativeLink
                    if (Post.Posts.FindAll(p => p.RelativeLink.Equals(post.RelativeLink)).Count < 2)
                    {
                        Navigation.NavigateTo(post.RelativeLink.ToString(), false, true);
                        return;
                    }
                }

                if (!post.IsVisible)
                {
                    Navigation.NavigateTo("/", false, true);
                    return;
                }

                LoadPost(post, rawUrl);
            }
            else
            {
                shouldThrow404Local = true;
            }
        }
        else if (!string.IsNullOrEmpty(Slug))
        {
            // Try to find post by slug
            Post post = Post.ApplicablePosts.Find(p =>
                p.Slug != null && p.Slug.Equals(Slug, StringComparison.OrdinalIgnoreCase));
            if (post != null && post.IsVisible)
            {
                LoadPost(post, rawUrl);
            }
            else
            {
                shouldThrow404Local = true;
            }
        }
        else
        {
            shouldThrow404Local = true;
        }

        if (shouldThrow404Local)
        {
            shouldShow404 = true;
            pageTitle = "Post not found";
        }
    }

    private void LoadPost(Post post, string rawUrl)
    {
        CurrentPost = post;

        // SEO redirect: ensure the URL matches the canonical RelativeLink
        int idx = rawUrl.IndexOf("?");
        var cleanUrl = idx > 0 ? rawUrl.Substring(0, idx) : rawUrl;
        if (cleanUrl != post.RelativeLink.ToString() && !string.IsNullOrEmpty(post.RelativeLink.ToString()))
        {
            // REVIEW: In the original, this was a 301 redirect. Blazor NavigateTo doesn't set status codes.
            // For SEO parity, consider middleware-based redirects.
        }

        string encodedPostTitle = HttpUtility.HtmlEncode(post.Title);
        pageTitle = encodedPostTitle;

        // Initialize navigation links
        InitNavigationLinks();

        // Handle comment notification unsubscription
        if (!string.IsNullOrEmpty(UnsubscribeEmail))
        {
            if (post.NotificationEmails.Contains(UnsubscribeEmail))
            {
                post.NotificationEmails.Remove(UnsubscribeEmail);
                post.Save();
                showCommentUnsubscription = true;
            }
        }
    }

    private Post GetNextPost(Post post)
    {
        if (post.Next == null) return null;
        if (post.Next.IsVisible) return post.Next;
        return GetNextPost(post.Next);
    }

    private Post GetPrevPost(Post post)
    {
        if (post.Previous == null) return null;
        if (post.Previous.IsVisible) return post.Previous;
        return GetPrevPost(post.Previous);
    }

    private void InitNavigationLinks()
    {
        if (BlogSettings.Instance.ShowPostNavigation && CurrentPost != null)
        {
            nextPost = GetNextPost(CurrentPost);
            prevPost = GetPrevPost(CurrentPost);

            if ((nextPost != null && !nextPost.Deleted) || (prevPost != null && !prevPost.Deleted))
            {
                showPostNavigation = true;
            }
        }
    }
}
