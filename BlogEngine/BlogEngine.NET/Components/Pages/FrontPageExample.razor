@page "/frontpageexample"

<PageTitle>Custom front page</PageTitle>

<div class="page-global">
    <h1>Custom front page</h1>
    <p>
        This is a custom front page. You can replace content of this page with your own and it will be displayed as front page for your blog.
    </p>
    <p>For this to work, page has to be in the blog root and named "FrontPage.razor" (Blazor component)</p>
</div>

@code {
    // Original code-behind had an empty Page_Load — this is a static template page.
    private string pageTitle = "Custom front page";
}
