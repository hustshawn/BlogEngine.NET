@page "/error"
@page "/error.aspx"
@layout PageLayout
@using System.Net
@using Microsoft.AspNetCore.Diagnostics

@* Port of error.aspx (the exception handler page outside Development) *@

<BlogHead Title="@BlogSettings.Instance.ErrorTitle" NoIndex="true" />

<div class="post page-global">
    <h2 class="page-global-title">@BlogSettings.Instance.ErrorTitle</h2>
    @((MarkupString)BlogSettings.Instance.ErrorText)

    @if (showErrorDetails && !string.IsNullOrEmpty(errorDetails))
    {
        <div id="divErrorDetails">
            <h2>Error Details:</h2>
            <p>@((MarkupString)errorDetailsHtml)</p>
        </div>
    }
</div>

@code {
    [CascadingParameter] public HttpContext HttpContext { get; set; }

    private bool showErrorDetails;
    private string errorDetails = string.Empty;
    private string errorDetailsHtml = string.Empty;

    protected override void OnInitialized()
    {
        var error = HttpContext?.Features.Get<IExceptionHandlerFeature>();
        if (error != null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status500InternalServerError;
        }

        // Details only for users with the right to view detailed error messages
        if (error?.Error != null && Security.IsAuthorizedTo(Rights.ViewDetailedErrorMessages))
        {
            errorDetails = error.Error.ToString();
        }

        if (!string.IsNullOrEmpty(errorDetails))
        {
            showErrorDetails = true;
            errorDetailsHtml = WebUtility.HtmlEncode(errorDetails).Replace(Environment.NewLine, "<br /><br />");
        }
    }
}
