@page "/Account/change-password-success"
@layout AccountLayout
@using BlogEngine.Core

<PageTitle>@Utils.Translate("changePassword")</PageTitle>

<h1 class="account-title">@Utils.Translate("changePassword")</h1>
<div class="account-body">
    <div id="ChangePwd" class="alert alert-success">
        @Utils.Translate("passwordChangeSuccess")
    </div>
    <br />
    <div class="btn-wrapper">
        <button class="btn btn-block btn-success" @onclick="GoHome">@Utils.Translate("home")</button>
    </div>
</div>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; }

    private void GoHome()
    {
        Navigation.NavigateTo(Utils.RelativeWebRoot, forceLoad: true);
    }
}
