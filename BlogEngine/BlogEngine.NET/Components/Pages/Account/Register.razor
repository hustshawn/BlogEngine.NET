@page "/Account/register"
@layout AccountLayout
@using System.Text.RegularExpressions
@inject NavigationManager Navigation

@* Port of Account/register.aspx (CreateUserWizard) as a static SSR form. The client-side checks of
   account.js ValidateNewUser run on the server; the new user is signed in and redirected afterwards. *@

<PageTitle>Register</PageTitle>

<AccountStatus Message="@statusMessage" />

<EditForm Model="Input" FormName="register" method="post" OnSubmit="HandleRegisterAsync">
    <h1 id="CreateHdr" class="account-title">@Utils.Translate("createAccount")</h1>
    <div class="account-body">
        <div class="form-group first-child">
            <label for="UserName" class="label-up">@Utils.Translate("userName"):</label>
            <div class="boxRound">
                <InputText id="UserName" @bind-Value="Input.UserName" class="textEntry form-control" autocomplete="username" autofocus />
            </div>
        </div>
        <div class="form-group">
            <label for="Email" class="label-up">@Utils.Translate("email"):</label>
            <div class="boxRound">
                <InputText id="Email" @bind-Value="Input.Email" class="textEntry form-control" autocomplete="email" />
            </div>
        </div>
        <div class="form-group">
            <label for="Password" class="label-up">@string.Format(Utils.Translate("passwordMinimumCharacters"), Membership.MinRequiredPasswordLength)</label>
            <div class="boxRound">
                <InputText id="Password" type="password" @bind-Value="Input.Password" class="passwordEntry form-control" autocomplete="new-password" />
            </div>
        </div>
        <div class="form-group">
            <label for="ConfirmPassword" class="label-up">@Utils.Translate("confirmPassword"):</label>
            <div class="boxRound">
                <InputText id="ConfirmPassword" type="password" @bind-Value="Input.ConfirmPassword" class="passwordEntry form-control" autocomplete="new-password" />
            </div>
        </div>

        <div class="btn-wrapper text-center">
            <button type="submit" id="CreateUserButton" class="btn btn-success btn-block">@Utils.Translate("createUser")</button>
        </div>
    </div>
</EditForm>

<hr />
<div class="account-body text-center text-uppercase">
    @Utils.Translate("alreadyHaveAccount")
    <a id="HeadLoginStatus" href="@(Utils.RelativeWebRoot)Account/login">@Utils.Translate("loginNow")</a>
</div>

@code {
    // account.js ValidateEmail
    private static readonly Regex EmailRegex = new(@"^([A-Za-z0-9_\-\.])+\@([A-Za-z0-9_\-\.])+\.([A-Za-z]{2,4})$", RegexOptions.Compiled);

    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    private string ReturnUrl { get; set; }

    [SupplyParameterFromForm(FormName = "register")]
    private RegisterModel Input { get; set; }

    private string statusMessage;

    protected override void OnInitialized()
    {
        Input ??= new RegisterModel();

        if (BlogSettings.Instance.CreateBlogOnSelfRegistration && Blog.CurrentInstance.IsPrimary)
        {
            Navigation.NavigateTo(Utils.RelativeWebRoot + "Account/create-blog");
            return;
        }

        // if self registration not allowed and user is trying to directly
        // navigate to register page, redirect to login
        if (!BlogSettings.Instance.EnableSelfRegistration)
        {
            Navigation.NavigateTo(Utils.RelativeWebRoot + "Account/login");
        }
    }

    private async Task HandleRegisterAsync()
    {
        var userName = (Input.UserName ?? string.Empty).Trim();
        var email = (Input.Email ?? string.Empty).Trim();

        statusMessage = Validate(userName, email);
        if (statusMessage != null)
        {
            return;
        }

        // RegisterUser_CreatingUser
        if (Membership.GetUser(userName) != null)
        {
            statusMessage = Utils.Translate("anotherUserName");
            return;
        }

        if (Membership.GetUserNameByEmail(email) != null)
        {
            statusMessage = Utils.Translate("anotherEmail");
            return;
        }

        Membership.CreateUser(userName, Input.Password, email, null, null, true, out var status);
        if (status != MembershipCreateStatus.Success)
        {
            statusMessage = status == MembershipCreateStatus.DuplicateUserName
                ? Utils.Translate("anotherUserName")
                : "Failed to create the new user.";
            return;
        }

        // RegisterUser_CreatedUser
        if (!string.IsNullOrEmpty(BlogSettings.Instance.SelfRegistrationInitialRole))
        {
            string role = Roles.GetAllRoles().FirstOrDefault(r => r.Equals(BlogSettings.Instance.SelfRegistrationInitialRole, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrEmpty(role))
            {
                Roles.AddUsersToRoles(new[] { userName }, new[] { role });
            }
        }

        await Security.AuthenticateUserAsync(userName, Input.Password, false);

        Navigation.NavigateTo(Security.GetSafeReturnUrl(ReturnUrl));
    }

    /// <summary>
    /// Server-side port of account.js ValidateNewUser; returns the first error or null.
    /// </summary>
    private string Validate(string userName, string email)
    {
        var password = Input.Password ?? string.Empty;
        var confirmPassword = Input.ConfirmPassword ?? string.Empty;

        if (userName.Length == 0)
            return Utils.Translate("userNameIsRequired");
        if (email.Length == 0)
            return Utils.Translate("emailIsRequired");
        if (!EmailRegex.IsMatch(email))
            return Utils.Translate("emailIsInvalid");
        if (password.Length == 0)
            return Utils.Translate("passwordIsRequried");
        if (password.Length < Membership.MinRequiredPasswordLength)
            return string.Format(Utils.Translate("minPassLengthInChars"), Membership.MinRequiredPasswordLength);
        if (confirmPassword.Length == 0)
            return Utils.Translate("confirmPasswordIsRequired");
        if (password != confirmPassword)
            return Utils.Translate("passwordAndConfirmPasswordIsMatch");

        return null;
    }

    private sealed class RegisterModel
    {
        public string UserName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
