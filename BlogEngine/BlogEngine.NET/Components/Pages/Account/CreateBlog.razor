@page "/Account/create-blog"
@layout AccountLayout
@inject NavigationManager Navigation

@* Port of Account/create-blog.aspx as a static SSR form (self-registration that creates a new blog
   on the primary instance). Validation is done by BlogGenerator, as in the original. *@

<PageTitle>@Utils.Translate("createBlog")</PageTitle>

<AccountStatus Message="@statusMessage" />

<EditForm Model="Input" FormName="create-blog" method="post" OnSubmit="HandleCreateBlog">
    <h1 class="account-title">@Utils.Translate("createBlog")</h1>
    <div class="account-body">
        <div class="form-group first-child ltr-dir">
            <label for="BlogName" class="label-up">@(Utils.AbsoluteWebRoot)<span id="blogId" style="font-weight: bold"></span></label>
            <InputText id="BlogName" @bind-Value="Input.BlogName" class="textEntry form-control"
                       oninput="document.getElementById('blogId').textContent=this.value" autofocus />
        </div>
        <div class="form-group">
            <label for="UserName" class="label-up">@Utils.Translate("userName"):</label>
            <InputText id="UserName" @bind-Value="Input.UserName" class="textEntry form-control ltr-dir" autocomplete="username" />
        </div>
        <div class="form-group">
            <label for="Email" class="label-up">@Utils.Translate("email"):</label>
            <InputText id="Email" @bind-Value="Input.Email" class="textEntry form-control ltr-dir" autocomplete="email" />
        </div>
        <div class="form-group">
            <label for="Password" class="label-up">@string.Format(Utils.Translate("passwordMinimumCharacters"), Membership.MinRequiredPasswordLength)</label>
            <InputText id="Password" type="password" @bind-Value="Input.Password" class="passwordEntry form-control ltr-dir" autocomplete="new-password" />
        </div>
        <div class="form-group">
            <label for="ConfirmPassword" class="label-up">@Utils.Translate("confirmPassword"):</label>
            <InputText id="ConfirmPassword" type="password" @bind-Value="Input.ConfirmPassword" class="passwordEntry form-control ltr-dir" autocomplete="new-password" />
        </div>

        <button type="submit" id="CreateUserButton" class="btn btn-success btn-block">Create</button>
    </div>
</EditForm>

@code {
    [SupplyParameterFromForm(FormName = "create-blog")]
    private CreateBlogModel Input { get; set; }

    private string statusMessage;

    protected override void OnInitialized()
    {
        Input ??= new CreateBlogModel();

        if (!BlogSettings.Instance.CreateBlogOnSelfRegistration || !Blog.CurrentInstance.IsPrimary)
        {
            Navigation.NavigateTo(Utils.RelativeWebRoot + "Account/login");
        }
    }

    private void HandleCreateBlog()
    {
        if (!BlogSettings.Instance.CreateBlogOnSelfRegistration || !Blog.CurrentInstance.IsPrimary)
        {
            return;
        }

        string blogName = (Input.BlogName ?? string.Empty).Trim().ToLower();
        string msg = CreateNewBlog();

        if (string.IsNullOrEmpty(msg))
        {
            Navigation.NavigateTo(Utils.ApplicationRelativeWebRoot + blogName);
            return;
        }

        statusMessage = msg;
    }

    private string CreateNewBlog()
    {
        string blogName = Input.BlogName ?? string.Empty;
        string userName = Input.UserName ?? string.Empty;
        string email = Input.Email ?? string.Empty;
        string password = Input.Password ?? string.Empty;

        if (!BlogGenerator.ValidateProperties(blogName, userName, email, out string message))
        {
            return string.IsNullOrWhiteSpace(message) ? "Validation for new blog failed." : message;
        }

        // Password rules of the registration form (account.js); the original relied on client-side checks only
        if (password.Length < Membership.MinRequiredPasswordLength)
        {
            return string.Format(Utils.Translate("minPassLengthInChars"), Membership.MinRequiredPasswordLength);
        }

        if (password != (Input.ConfirmPassword ?? string.Empty))
        {
            return Utils.Translate("passwordAndConfirmPasswordIsMatch");
        }

        // REVIEW: the original validated a RecaptchaControl here; reCAPTCHA has not been ported to Blazor.

        Blog blog = BlogGenerator.CreateNewBlog(blogName, userName, email, password, out message);

        if (blog == null || !string.IsNullOrWhiteSpace(message))
        {
            return message ?? "Failed to create the new blog.";
        }

        return message;
    }

    private sealed class CreateBlogModel
    {
        public string BlogName { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
