@page "/Account/login"
@layout AccountLayout
@inject NavigationManager Navigation

@* Port of Account/login.aspx as a static SSR form. Sign-in happens in Security.AuthenticateUserAsync
   during the POST; "?logoff" signs out like the original Page_Load. *@

<PageTitle>@Utils.Translate("login")</PageTitle>

<AccountStatus Message="@statusMessage" />

<EditForm Model="Input" FormName="login" method="post" OnSubmit="HandleLoginAsync">
    <h1 class="account-title">@Utils.Translate("login")</h1>
    <div class="account-body">
        <div class="form-group">
            <label for="UserName">Username</label>
            <InputText id="UserName" @bind-Value="Input.UserName" class="textEntry ltr-dir" autocomplete="username" autofocus />
        </div>
        <div class="form-group">
            <label for="Password">Password</label>
            <InputText id="Password" type="password" @bind-Value="Input.Password" class="passwordEntry ltr-dir" autocomplete="current-password" />
        </div>
        <div class="form-group with-icon">
            <span class="icon-form-group">
                <InputCheckbox id="RememberMe" @bind-Value="Input.RememberMe" />
            </span>
            <label for="RememberMe" class="label-title">@Utils.Translate("rememberMe")</label>
        </div>
        <button type="submit" id="LoginButton" class="btn btn-success btn-block btn-lg">@Utils.Translate("login")</button>
        @if (BlogSettings.Instance.EnablePasswordReset)
        {
            <div class="small-link">
                <a href="@(Utils.RelativeWebRoot)Account/password-retrieval" class="text-muted">@Utils.Translate("forgotPassword")</a>
            </div>
        }
    </div>
</EditForm>

@if (BlogSettings.Instance.EnableSelfRegistration)
{
    <hr />
    <div id="LoginRegister" class="text-center account-body text-uppercase">
        @Utils.Translate("dontHaveAccount")
        <a href="@RegisterUrl">@Utils.Translate("createNow")</a>
    </div>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    private string ReturnUrl { get; set; }

    [SupplyParameterFromForm(FormName = "login")]
    private LoginModel Input { get; set; }

    private string statusMessage;

    private string RegisterUrl => Utils.RelativeWebRoot + "Account/register?ReturnUrl=" + Uri.EscapeDataString(ReturnUrl ?? string.Empty);

    protected override async Task OnInitializedAsync()
    {
        Input ??= new LoginModel();

        // Original: login.aspx?logoff signs out and goes back to the referrer (unless it is an admin page)
        if (HttpMethods.IsGet(HttpContext.Request.Method) && HttpContext.Request.QueryString.Value == "?logoff")
        {
            await Security.SignOutAsync();
            Navigation.NavigateTo(GetLogoffRedirectUrl());
        }
    }

    private async Task HandleLoginAsync()
    {
        if (await Security.AuthenticateUserAsync(Input.UserName, Input.Password, Input.RememberMe))
        {
            // Only local return urls are honored (open redirect protection)
            Navigation.NavigateTo(Security.GetSafeReturnUrl(ReturnUrl));
            return;
        }

        statusMessage = Utils.Translate("loginFailed");
    }

    /// <summary>
    /// Referrer of the same site that is not the login page itself or an admin page; otherwise the blog root.
    /// </summary>
    private string GetLogoffRedirectUrl()
    {
        var request = HttpContext.Request;
        if (Uri.TryCreate(request.Headers.Referer.ToString(), UriKind.Absolute, out var referrer) &&
            string.Equals(referrer.Authority, request.Host.Value, StringComparison.OrdinalIgnoreCase) &&
            referrer.AbsolutePath.IndexOf("/admin/", StringComparison.OrdinalIgnoreCase) == -1 &&
            referrer.AbsolutePath.IndexOf("/Account/login", StringComparison.OrdinalIgnoreCase) == -1)
        {
            return Security.GetSafeReturnUrl(referrer.PathAndQuery);
        }

        return Utils.RelativeWebRoot;
    }

    private sealed class LoginModel
    {
        public string UserName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public bool RememberMe { get; set; }
    }
}
