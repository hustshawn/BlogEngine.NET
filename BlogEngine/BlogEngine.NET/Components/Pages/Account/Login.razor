@page "/Account/login"
@layout AccountLayout
@using BlogEngine.Core
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using System.Security.Claims
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@Utils.Translate("login")</PageTitle>

<h1 class="account-title">@Utils.Translate("login")</h1>
<div class="account-body">
    <div class="form-group">
        <label>Username</label>
        <input type="text" @bind="userName" class="textEntry ltr-dir" />
    </div>
    <div class="form-group">
        <label>Password</label>
        <input type="password" @bind="password" class="passwordEntry ltr-dir" />
    </div>
    <div class="form-group with-icon">
        <span class="icon-form-group">
            <input type="checkbox" @bind="rememberMe" />
        </span>
        <label class="label-title">@Utils.Translate("rememberMe")</label>
    </div>
    <button class="btn btn-success btn-block btn-lg" @onclick="HandleLogin">@Utils.Translate("login")</button>
    @if (BlogSettings.Instance.EnablePasswordReset)
    {
        <div class="small-link">
            <a href="/Account/password-retrieval" class="text-muted">@Utils.Translate("forgotPassword")</a>
        </div>
    }
</div>

@if (BlogSettings.Instance.EnableSelfRegistration)
{
    <hr />
    <div id="LoginRegister" class="text-center account-body text-uppercase">
        @Utils.Translate("dontHaveAccount")
        <a href="@registerUrl">@Utils.Translate("createNow")</a>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-warning">@errorMessage</div>
}

@code {
    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    public string ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "logoff")]
    public string LogOff { get; set; }

    private string userName = string.Empty;
    private string password = string.Empty;
    private bool rememberMe;
    private string errorMessage = string.Empty;
    private string registerUrl = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        registerUrl = Utils.RelativeWebRoot + "Account/register?ReturnUrl=" + Uri.EscapeDataString(ReturnUrl ?? "");

        // Handle logoff via query string (original: ?logoff)
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null)
        {
            var queryString = httpContext.Request.QueryString.Value;
            if (queryString == "?logoff")
            {
                Security.SignOut();
                await httpContext.SignOutAsync(CookieAuthenticationDefaults.AuthenticationScheme);

                var referer = httpContext.Request.Headers["Referer"].ToString();
                if (!string.IsNullOrEmpty(referer))
                {
                    var refUri = new Uri(referer);
                    if (refUri.LocalPath.IndexOf("/admin/", StringComparison.OrdinalIgnoreCase) == -1)
                    {
                        Navigation.NavigateTo(referer, forceLoad: true);
                        return;
                    }
                }

                Navigation.NavigateTo(Utils.RelativeWebRoot, forceLoad: true);
                return;
            }

            // If already authenticated, no need to show login
            if (Security.IsAuthenticated)
            {
                Navigation.NavigateTo(ReturnUrl ?? Utils.RelativeWebRoot, forceLoad: true);
                return;
            }
        }
    }

    private async Task HandleLogin()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext == null)
        {
            errorMessage = Utils.Translate("loginFailed");
            return;
        }

        // Use BlogEngine.Core Security to authenticate
        bool authenticated = Security.AuthenticateUser(userName, password, rememberMe);

        if (authenticated || Security.IsAuthenticated)
        {
            // Create claims principal for cookie auth
            var claims = new List<Claim>
            {
                new Claim(ClaimTypes.Name, userName)
            };

            // Add role claims
            try
            {
                var roles = BlogEngine.Core.Roles.GetRolesForUser(userName);
                foreach (var role in roles)
                {
                    claims.Add(new Claim(ClaimTypes.Role, role));
                }
            }
            catch
            {
                // Roles provider may not be available
            }

            var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
            var principal = new ClaimsPrincipal(identity);

            await httpContext.SignInAsync(
                CookieAuthenticationDefaults.AuthenticationScheme,
                principal,
                new AuthenticationProperties
                {
                    IsPersistent = rememberMe,
                    ExpiresUtc = rememberMe ? DateTimeOffset.UtcNow.AddDays(90) : null
                });

            var redirectUrl = ReturnUrl;
            if (string.IsNullOrEmpty(redirectUrl))
            {
                redirectUrl = Utils.RelativeWebRoot;
            }

            Navigation.NavigateTo(redirectUrl, forceLoad: true);
        }
        else
        {
            errorMessage = Utils.Translate("loginFailed");
        }
    }
}
