@page "/Account/logout"
@layout AccountLayout
@inject NavigationManager Navigation

@* Port of Account/Logout.cshtml: signs out during the SSR request, then redirects
   to the (local) ReturnUrl or the blog root. *@

<PageTitle>Logging out...</PageTitle>

@code {
    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    private string ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Security.SignOutAsync();
        Navigation.NavigateTo(Security.GetSafeReturnUrl(ReturnUrl));
    }
}
