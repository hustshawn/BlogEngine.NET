@page "/Account/password-retrieval"
@layout AccountLayout
@using BlogEngine.Core
@using System.Net.Mail
@using System.Text
// Membership and Roles are provided by BlogEngine.Core namespace
@inject NavigationManager Navigation

<PageTitle>@Utils.Translate("passwordRetrieval")</PageTitle>

<h1 class="account-title">@Utils.Translate("passwordRetrieval")</h1>
<div class="account-body">
    <div class="form-group with-icon first-child">
        <label>@inputLabel</label>
        <input type="text" @bind="inputValue" placeholder="" class="textEntry form-control" />
    </div>
    <button class="btn btn-block btn-success" @onclick="HandleSubmit">@Utils.Translate("send")</button>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert-@statusType">@statusMessage</div>
}

@code {
    private string inputValue = string.Empty;
    private string inputLabel = "Username";
    private string statusMessage = string.Empty;
    private string statusType = "warning";

    // State for the multi-step flow
    private string confirmationCode = string.Empty;
    private string storedUserName = string.Empty;
    private string storedEmail = string.Empty;
    private bool waitingForCode;

    protected override void OnInitialized()
    {
        if (!BlogSettings.Instance.EnablePasswordReset)
        {
            Navigation.NavigateTo(Utils.RelativeWebRoot + "Account/login", forceLoad: true);
        }
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrEmpty(storedUserName))
        {
            // Step 1: Look up the user
            var user = Membership.GetUser(inputValue.Trim());
            if (user == null)
            {
                statusType = "warning";
                statusMessage = "User not found";
                return;
            }

            storedUserName = inputValue.Trim();
            storedEmail = user.Email;

            if (string.IsNullOrEmpty(storedEmail))
            {
                statusType = "warning";
                statusMessage = Utils.Translate("emailIsRequired");
                return;
            }

            // Proceed to send confirmation code
            SendCode();
            inputValue = string.Empty;
            inputLabel = "Confirmation Code";
            waitingForCode = true;
        }
        else if (!string.IsNullOrEmpty(confirmationCode))
        {
            // Step 2: Verify confirmation code
            if (inputValue == confirmationCode)
            {
                SendPasswordResetMail();
            }
            else
            {
                statusType = "warning";
                statusMessage = "Sorry, code does not match. Please try again.";
            }
        }
        else
        {
            // Code not yet sent, re-send
            SendCode();
        }
    }

    private void SendCode()
    {
        confirmationCode = new Random().Next(1000, 9999).ToString();

        var mail = new MailMessage
        {
            From = new MailAddress(BlogSettings.Instance.Email),
            Subject = "Your code for password reset is: " + confirmationCode
        };

        mail.To.Add(storedEmail);

        var sb = new StringBuilder();
        sb.Append("<div style=\"font: 11px verdana, arial\">");
        sb.AppendFormat("Dear {0}:", storedUserName);
        sb.AppendFormat("<br/><br/>Your password reset code at \"{0}\" is: {1}", BlogSettings.Instance.Name, confirmationCode);
        sb.Append("<br/></br>Please enter this code in the form you used to send this email and we will reset password and send it to you.");
        sb.Append("<br/><br/>If it wasn't you who initiated the reset, please let us know immediately (use contact form on our site)");
        sb.AppendFormat("<br/><br/>Sincerely,<br/><br/><a href=\"{0}\">{1}</a> team.", Utils.AbsoluteWebRoot, BlogSettings.Instance.Name);
        sb.Append("</div>");

        mail.Body = sb.ToString();

        var msg = Utils.SendMailMessage(mail);

        if (string.IsNullOrEmpty(msg))
        {
            statusType = "success";
            statusMessage = "Confirmation code was sent, please check your email.";
        }
        else
        {
            statusType = "warning";
            statusMessage = msg;
            ClearState();
        }
    }

    private void SendPasswordResetMail()
    {
        var mail = new MailMessage
        {
            From = new MailAddress(BlogSettings.Instance.Email),
            Subject = "Your password has been reset"
        };

        mail.To.Add(storedEmail);

        var pwd = Membership.Provider.ResetPassword(storedUserName);
        var sb = new StringBuilder();
        sb.Append("<div style=\"font: 11px verdana, arial\">");
        sb.AppendFormat("Dear {0}:", storedUserName);
        sb.AppendFormat("<br/><br/>Your password at \"{0}\" has been reset to: {1}", BlogSettings.Instance.Name, pwd);
        sb.Append("<br/><br/>If it wasn't you who initiated the reset, please let us know immediately (use contact form on our site)");
        sb.AppendFormat("<br/><br/>Sincerely,<br/><br/><a href=\"{0}\">{1}</a> team.", Utils.AbsoluteWebRoot, BlogSettings.Instance.Name);
        sb.Append("</div>");

        mail.Body = sb.ToString();

        Utils.SendMailMessageAsync(mail);
        ClearState();

        Navigation.NavigateTo(Utils.RelativeWebRoot + "Account/login", forceLoad: true);
    }

    private void ClearState()
    {
        confirmationCode = string.Empty;
        storedUserName = string.Empty;
        storedEmail = string.Empty;
        waitingForCode = false;
        inputLabel = "Username";
    }
}
