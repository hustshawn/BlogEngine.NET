@page "/Account/password-retrieval"
@layout AccountLayout
@using System.Net.Mail
@using System.Security.Cryptography
@using System.Text
@using Microsoft.Extensions.Caching.Memory
@inject NavigationManager Navigation
@inject IMemoryCache Cache

@* Port of Account/password-retrieval.aspx as a static SSR form.
   Step 1: user name -> a confirmation code is e-mailed. Step 2: code -> the password is reset and e-mailed.
   The original kept the pending code in static fields (shared by all visitors); here it is kept
   per blog + user in the memory cache with an expiry and a limited number of attempts. *@

<PageTitle>@Utils.Translate("passwordRetrieval")</PageTitle>

<AccountStatus Status="@statusType" Message="@statusMessage" />

<EditForm Model="Input" FormName="password-retrieval" method="post" OnSubmit="HandleSubmit">
    <h1 class="account-title">@Utils.Translate("passwordRetrieval")</h1>
    <div class="account-body">
        <div class="form-group with-icon first-child">
            @if (awaitingCode)
            {
                <input type="hidden" name="Input.UserName" value="@Input.UserName" />
                <input type="hidden" name="Input.Step" value="code" />
                <label for="txtUser">Confirmation code</label>
                <InputText id="txtUser" @bind-Value="Input.Code" class="textEntry form-control" autocomplete="one-time-code" autofocus />
            }
            else
            {
                <label for="txtUser">Username</label>
                <InputText id="txtUser" @bind-Value="Input.UserName" class="textEntry form-control" autocomplete="username" autofocus />
            }
        </div>
        <button type="submit" id="LoginButton" class="btn btn-block btn-success">@Utils.Translate("send")</button>
    </div>
</EditForm>

@code {
    private const int MaxCodeAttempts = 5;
    private static readonly TimeSpan CodeLifetime = TimeSpan.FromMinutes(15);

    [SupplyParameterFromForm(FormName = "password-retrieval")]
    private RetrievalModel Input { get; set; }

    private bool awaitingCode;
    private string statusMessage;
    private string statusType = "warning";

    protected override void OnInitialized()
    {
        Input ??= new RetrievalModel();

        if (!BlogSettings.Instance.EnablePasswordReset)
        {
            Navigation.NavigateTo(Utils.RelativeWebRoot + "Account/login");
        }
    }

    private void HandleSubmit()
    {
        var userName = (Input.UserName ?? string.Empty).Trim();
        if (userName.Length == 0)
        {
            SetStatus("warning", Utils.Translate("userNameIsRequired"));
            return;
        }

        if (Input.Step == "code")
        {
            VerifyCode(userName, (Input.Code ?? string.Empty).Trim());
        }
        else
        {
            SendCode(userName);
        }
    }

    private void SendCode(string userName)
    {
        var user = Membership.GetUser(userName);
        if (user == null)
        {
            SetStatus("warning", "User not found");
            return;
        }

        if (string.IsNullOrEmpty(user.Email))
        {
            SetStatus("warning", Utils.Translate("emailIsRequired"));
            return;
        }

        var pending = new PendingReset(user.UserName, user.Email, RandomNumberGenerator.GetInt32(100000, 1000000).ToString());

        var sb = new StringBuilder();
        sb.Append("<div style=\"font: 11px verdana, arial\">");
        sb.AppendFormat("Dear {0}:", Encode(pending.UserName));
        sb.AppendFormat("<br/><br/>Your password reset code at \"{0}\" is: {1}", Encode(BlogSettings.Instance.Name), pending.Code);
        sb.Append("<br/></br>Please enter this code in the form you used to send this email and we will reset password and send it to you.");
        sb.Append("<br/><br/>If it wasn't you who initiated the reset, please let us know immediately (use contact form on our site)");
        sb.AppendFormat("<br/><br/>Sincerely,<br/><br/><a href=\"{0}\">{1}</a> team.", Utils.AbsoluteWebRoot, Encode(BlogSettings.Instance.Name));
        sb.Append("</div>");

        var error = SendMail(pending.Email, "Your code for password reset is: " + pending.Code, sb.ToString(), async: false);
        if (!string.IsNullOrEmpty(error))
        {
            SetStatus("warning", error);
            Cache.Remove(CacheKey(userName));
            return;
        }

        Cache.Set(CacheKey(userName), pending, CodeLifetime);
        Input.UserName = pending.UserName;
        awaitingCode = true;
        SetStatus("success", "Confirmation code was sent, please check your email.");
    }

    private void VerifyCode(string userName, string code)
    {
        if (!Cache.TryGetValue(CacheKey(userName), out PendingReset pending))
        {
            // expired or never requested: start over
            SetStatus("warning", "Sorry, code does not match. Please try again.");
            return;
        }

        if (!CryptographicOperations.FixedTimeEquals(Encoding.UTF8.GetBytes(code), Encoding.UTF8.GetBytes(pending.Code)))
        {
            if (Interlocked.Increment(ref pending.FailedAttempts) >= MaxCodeAttempts)
            {
                Cache.Remove(CacheKey(userName));
            }
            else
            {
                awaitingCode = true;
            }

            SetStatus("warning", "Sorry, code does not match. Please try again.");
            return;
        }

        Cache.Remove(CacheKey(userName));

        var pwd = Membership.Provider.ResetPassword(pending.UserName);
        if (string.IsNullOrEmpty(pwd))
        {
            SetStatus("warning", Utils.Translate("passwordNotChanged"));
            return;
        }

        var sb = new StringBuilder();
        sb.Append("<div style=\"font: 11px verdana, arial\">");
        sb.AppendFormat("Dear {0}:", Encode(pending.UserName));
        sb.AppendFormat("<br/><br/>Your password at \"{0}\" has been reset to: {1}", Encode(BlogSettings.Instance.Name), Encode(pwd));
        sb.Append("<br/><br/>If it wasn't you who initiated the reset, please let us know immediately (use contact form on our site)");
        sb.AppendFormat("<br/><br/>Sincerely,<br/><br/><a href=\"{0}\">{1}</a> team.", Utils.AbsoluteWebRoot, Encode(BlogSettings.Instance.Name));
        sb.Append("</div>");

        SendMail(pending.Email, "Your password has been reset", sb.ToString(), async: true);

        Navigation.NavigateTo(Utils.RelativeWebRoot + "Account/login");
    }

    /// <summary>
    /// Sends an e-mail from the blog address; returns an error message on failure (never throws).
    /// </summary>
    private static string SendMail(string to, string subject, string body, bool async)
    {
        MailMessage mail;
        try
        {
            mail = new MailMessage { From = new MailAddress(BlogSettings.Instance.Email), Subject = subject, Body = body };
            mail.To.Add(to);
        }
        catch (FormatException ex)
        {
            Utils.Log("Password retrieval: invalid e-mail address", ex);
            return "Error sending email: " + ex.Message;
        }
        catch (ArgumentException ex)
        {
            Utils.Log("Password retrieval: invalid e-mail address", ex);
            return "Error sending email: " + ex.Message;
        }

        if (async)
        {
            Utils.SendMailMessageAsync(mail);
            return string.Empty;
        }

        return Utils.SendMailMessage(mail);
    }

    private static string CacheKey(string userName) =>
        "password-retrieval:" + Blog.CurrentInstance.Id + ":" + userName.ToLowerInvariant();

    private static string Encode(string value) => System.Net.WebUtility.HtmlEncode(value);

    private void SetStatus(string type, string message)
    {
        statusType = type;
        statusMessage = message;
    }

    private sealed class PendingReset(string userName, string email, string code)
    {
        public string UserName { get; } = userName;
        public string Email { get; } = email;
        public string Code { get; } = code;
        public int FailedAttempts;
    }

    private sealed class RetrievalModel
    {
        public string UserName { get; set; } = string.Empty;

        /// <summary>
        /// "code" on the second step (confirmation code entry).
        /// </summary>
        public string Step { get; set; }

        public string Code { get; set; }
    }
}
