@page "/Account/change-password"
@layout AccountLayout
@using BlogEngine.Core
// Membership and Roles are provided by BlogEngine.Core namespace
@inject NavigationManager Navigation

<PageTitle>@Utils.Translate("changePassword")</PageTitle>

<h1 class="account-title">@Utils.Translate("changePassword")</h1>
<div class="account-body">
    <div class="form-group first-child">
        <label class="label-up">@Utils.Translate("oldPassword"):</label>
        <input type="password" @bind="currentPassword" placeholder="" class="passwordEntry form-control ltr-dir" />
    </div>
    <div class="form-group">
        <label class="label-up">@Utils.Translate("newPassword"):</label>
        <input type="password" @bind="newPassword" class="passwordEntry form-control ltr-dir" />
    </div>
    <div class="form-group">
        <label class="label-up">@Utils.Translate("confirmNewPassword"):</label>
        <input type="password" @bind="confirmNewPassword" class="passwordEntry form-control ltr-dir" />
    </div>
    <div class="btn-wrapper">
        <button class="btn btn-block btn-success" @onclick="HandleChangePassword">@Utils.Translate("changePassword")</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="alert alert-@statusType">@statusMessage</div>
}

@code {
    private string currentPassword = string.Empty;
    private string newPassword = string.Empty;
    private string confirmNewPassword = string.Empty;
    private string statusMessage = string.Empty;
    private string statusType = "warning";

    private void HandleChangePassword()
    {
        if (string.IsNullOrWhiteSpace(currentPassword))
        {
            statusType = "warning";
            statusMessage = Utils.Translate("oldPasswordIsRequired");
            return;
        }

        if (string.IsNullOrWhiteSpace(newPassword))
        {
            statusType = "warning";
            statusMessage = Utils.Translate("newPasswordIsRequired");
            return;
        }

        if (newPassword != confirmNewPassword)
        {
            statusType = "warning";
            statusMessage = Utils.Translate("newAndConfirmPasswordMismatch");
            return;
        }

        if (newPassword.Length < Membership.MinRequiredPasswordLength)
        {
            statusType = "warning";
            statusMessage = string.Format(Utils.Translate("minPassLengthInChars"), Membership.MinRequiredPasswordLength);
            return;
        }

        try
        {
            var user = Membership.GetUser();
            if (user != null)
            {
                bool changed = Membership.Provider.ChangePassword(user.UserName, currentPassword, newPassword);
                if (changed)
                {
                    Navigation.NavigateTo("/Account/change-password-success", forceLoad: true);
                    return;
                }
            }

            statusType = "warning";
            statusMessage = Utils.Translate("passwordNotChanged");
        }
        catch (Exception)
        {
            statusType = "warning";
            statusMessage = Utils.Translate("passwordNotChanged");
        }
    }
}
