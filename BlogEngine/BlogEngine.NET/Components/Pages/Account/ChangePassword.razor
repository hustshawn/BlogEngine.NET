@page "/Account/change-password"
@layout AccountLayout
@inject NavigationManager Navigation

@* Port of Account/change-password.aspx (asp:ChangePassword) as a static SSR form for the signed-in user.
   The client-side checks of account.js ValidateChangePassword run on the server. *@

<PageTitle>@Utils.Translate("changePassword")</PageTitle>

<AccountStatus Message="@statusMessage" />

<h1 class="account-title">@Utils.Translate("changePassword")</h1>

<EditForm Model="Input" FormName="change-password" method="post" OnSubmit="HandleChangePassword">
    <div class="account-body">
        <div class="form-group first-child">
            <label for="CurrentPassword" class="label-up">@Utils.Translate("oldPassword"):</label>
            <InputText id="CurrentPassword" type="password" @bind-Value="Input.CurrentPassword" class="passwordEntry form-control ltr-dir" autocomplete="current-password" autofocus />
        </div>
        <div class="form-group">
            <label for="NewPassword" class="label-up">@Utils.Translate("newPassword"):</label>
            <InputText id="NewPassword" type="password" @bind-Value="Input.NewPassword" class="passwordEntry form-control ltr-dir" autocomplete="new-password" />
        </div>
        <div class="form-group">
            <label for="ConfirmNewPassword" class="label-up">@Utils.Translate("confirmNewPassword"):</label>
            <InputText id="ConfirmNewPassword" type="password" @bind-Value="Input.ConfirmNewPassword" class="passwordEntry form-control ltr-dir" autocomplete="new-password" />
        </div>
        <div class="btn-wrapper">
            <button type="submit" id="ChangePasswordPushButton" class="btn btn-block btn-success">@Utils.Translate("changePassword")</button>
        </div>
    </div>
</EditForm>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "change-password")]
    private ChangePasswordModel Input { get; set; }

    private string statusMessage;

    protected override void OnInitialized()
    {
        Input ??= new ChangePasswordModel();

        // The ChangePassword control needs a signed-in user
        if (!Security.IsAuthenticated)
        {
            Navigation.NavigateTo(Utils.RelativeWebRoot + "Account/login?ReturnUrl=" +
                Uri.EscapeDataString(HttpContext.Request.PathBase + HttpContext.Request.Path));
        }
    }

    private void HandleChangePassword()
    {
        if (!Security.IsAuthenticated)
        {
            return;
        }

        statusMessage = Validate();
        if (statusMessage != null)
        {
            return;
        }

        if (Membership.Provider.ChangePassword(Security.CurrentUser.Identity.Name, Input.CurrentPassword, Input.NewPassword))
        {
            Navigation.NavigateTo(Utils.RelativeWebRoot + "Account/change-password-success");
            return;
        }

        statusMessage = Utils.Translate("passwordNotChanged");
    }

    /// <summary>
    /// Server-side port of account.js ValidateChangePassword; returns the first error or null.
    /// </summary>
    private string Validate()
    {
        var current = Input.CurrentPassword ?? string.Empty;
        var newPassword = Input.NewPassword ?? string.Empty;
        var confirm = Input.ConfirmNewPassword ?? string.Empty;

        if (current.Length == 0)
            return Utils.Translate("oldPasswordIsRequired");
        if (newPassword.Length == 0)
            return Utils.Translate("newPasswordIsRequired");
        if (newPassword.Length < Membership.MinRequiredPasswordLength)
            return string.Format(Utils.Translate("minPassLengthInChars"), Membership.MinRequiredPasswordLength);
        if (confirm.Length == 0)
            return Utils.Translate("confirmPasswordIsRequired");
        if (newPassword != confirm)
            return Utils.Translate("newAndConfirmPasswordMismatch");

        return null;
    }

    private sealed class ChangePasswordModel
    {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmNewPassword { get; set; } = string.Empty;
    }
}
