@page "/"
@page "/default"
@page "/default.aspx"
@page "/blog"
@page "/blog.aspx"
@page "/category/{CategoryName}"
@page "/author/{AuthorName}"
@page "/tag/{TagName}"
@page "/calendar"
@page "/calendar/default"
@page "/calendar/default.aspx"
@page "/{Year:int}/default"
@page "/{Year:int}/default.aspx"
@page "/{Year:int}/{Month:int}"
@page "/{Year:int}/{Month:int}/default"
@page "/{Year:int}/{Month:int}/default.aspx"
@page "/{Year:int}/{Month:int}/{Day:int}"
@page "/{Year:int}/{Month:int}/{Day:int}/default"
@page "/{Year:int}/{Month:int}/{Day:int}/default.aspx"
@using System.Globalization
@using System.Xml
@inject NavigationManager Navigation

@* Port of default.aspx: post list by all/category/author/tag/date, calendar and APML filtering.
   The URL rewrites of the original (UrlRules) are the routes above. *@

<BlogHead Title="@title" Description="@metaDescription" Keywords="@metaKeywords" Author="@BlogSettings.Instance.AuthorName" NoIndex="@noIndex" />

<div id="divError">@((MarkupString)errorHtml)</div>
@if (showPostList)
{
    <PostList Posts="@posts" ContentBy="@contentBy" />
}
@if (showCalendar)
{
    <PostCalendar ShowPostTitles="true" />
}

@code {
    [CascadingParameter] public HttpContext HttpContext { get; set; }

    [Parameter] public string CategoryName { get; set; }
    [Parameter] public string AuthorName { get; set; }
    [Parameter] public string TagName { get; set; }
    [Parameter] public int? Year { get; set; }
    [Parameter] public int? Month { get; set; }
    [Parameter] public int? Day { get; set; }

    [SupplyParameterFromQuery(Name = "id")] public string QueryId { get; set; }
    [SupplyParameterFromQuery(Name = "name")] public string QueryName { get; set; }
    [SupplyParameterFromQuery(Name = "tag")] public string QueryTag { get; set; }
    [SupplyParameterFromQuery(Name = "year")] public string QueryYear { get; set; }
    [SupplyParameterFromQuery(Name = "month")] public string QueryMonth { get; set; }
    [SupplyParameterFromQuery(Name = "date")] public string QueryDate { get; set; }
    [SupplyParameterFromQuery(Name = "calendar")] public string QueryCalendar { get; set; }
    [SupplyParameterFromQuery(Name = "apml")] public string QueryApml { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public string QueryPage { get; set; }

    private string title = string.Empty;
    private string errorHtml = string.Empty;
    private string metaDescription;
    private string metaKeywords;
    private bool noIndex;
    private bool showPostList = true;
    private bool showCalendar;
    private List<IPublishable> posts;
    private ServingContentBy contentBy = ServingContentBy.AllContent;

    protected override void OnParametersSet()
    {
        var path = HttpContext?.Request.Path.Value?.ToLowerInvariant() ?? string.Empty;
        var rawUrl = path + HttpContext?.Request.QueryString.Value?.ToLowerInvariant();

        ProcessSearchEngine(rawUrl);

        if (CategoryName != null || (path.Contains("/category/") && QueryId != null))
        {
            DisplayCategories();
        }
        else if (AuthorName != null || QueryName != null)
        {
            DisplayAuthors();
        }
        else if (TagName != null || !string.IsNullOrEmpty(QueryTag))
        {
            DisplayTags();
        }
        else if (Year.HasValue || path.Contains("/calendar") || QueryYear != null || QueryDate != null || QueryCalendar != null)
        {
            if (QueryYear != null)
            {
                RedirectOldDateUrl();
            }
            else
            {
                DisplayDateRange(path);
            }
        }
        else if (QueryApml != null)
        {
            DisplayApmlFiltering();
        }
        else if (!string.IsNullOrEmpty(QueryId) && Guid.TryParse(QueryId, out var categoryId))
        {
            // default.aspx?id={category id}
            DisplayCategory(Category.GetCategory(categoryId, Blog.CurrentInstance.IsSiteAggregation));
        }
        else
        {
            title = BlogSettings.Instance.UseBlogNameInPageTitles ? string.Empty : BlogSettings.Instance.Name + " | ";
            if (!string.IsNullOrEmpty(BlogSettings.Instance.Description))
            {
                title += BlogSettings.Instance.Description;
            }
            metaDescription = BlogHead.MetaDescription(BlogSettings.Instance.Description);
        }

        AddMetaKeywords();
    }

    /// <summary>
    /// Crawlers are sent to the home page for list pages that should not be indexed.
    /// </summary>
    private void ProcessSearchEngine(string rawUrl)
    {
        var userAgent = HttpContext?.Request.Headers.UserAgent.ToString().ToLowerInvariant() ?? string.Empty;
        var isCrawler = userAgent.Contains("bot") || userAgent.Contains("crawler") || userAgent.Contains("spider") || userAgent.Contains("slurp");
        if (!isCrawler)
        {
            return;
        }

        if (rawUrl.Contains("/category/") || rawUrl.Contains("?tag") || rawUrl.Contains("?page="))
        {
            noIndex = true;
            HttpContext.Response.Redirect(Utils.RelativeWebRoot, permanent: true);
        }
    }

    private void DisplayCategories()
    {
        Category category = null;
        if (!string.IsNullOrEmpty(CategoryName))
        {
            var name = StripExtension(CategoryName);
            category = Category.ApplicableCategories.FirstOrDefault(c =>
                name.Equals(Utils.RemoveIllegalCharacters(c.Title), StringComparison.OrdinalIgnoreCase));
        }
        else if (Guid.TryParse(QueryId, out var categoryId))
        {
            category = Category.GetCategory(categoryId, Blog.CurrentInstance.IsSiteAggregation);
        }

        if (category == null)
        {
            Navigation.NotFound();
            return;
        }

        DisplayCategory(category);
    }

    private void DisplayCategory(Category category)
    {
        if (category == null)
        {
            return;
        }

        contentBy = ServingContentBy.Category;
        posts = Post.GetPostsByCategory(category).ConvertAll(p => (IPublishable)p);
        title = category.Title;
        metaDescription = BlogHead.MetaDescription(string.IsNullOrWhiteSpace(category.Description) ? category.Title : category.Description);
    }

    private void DisplayAuthors()
    {
        var author = StripExtension(AuthorName ?? QueryName);
        if (string.IsNullOrEmpty(author))
        {
            return;
        }

        author = Uri.UnescapeDataString(author);
        contentBy = ServingContentBy.Author;
        posts = Post.GetPostsByAuthor(author).ConvertAll(p => (IPublishable)p);
        title = Utils.Translate("AllPostsBy") + " " + author;
        metaDescription = BlogHead.MetaDescription(title);
    }

    private void DisplayTags()
    {
        var tag = TagName ?? QueryTag;
        tag = tag.StartsWith("/") ? tag.Substring(1) : tag;
        contentBy = ServingContentBy.Tag;
        posts = Post.GetPostsByTag(tag).ConvertAll(p => (IPublishable)p);
        title = string.Format("{0} '{1}'", Utils.Translate("AllPostsTagged"), tag);
        metaDescription = BlogHead.MetaDescription(title);
    }

    private void DisplayDateRange(string path)
    {
        try
        {
            if (Year.HasValue && Month.HasValue && Day.HasValue)
            {
                ShowPostsByDate(new DateTime(Year.Value, Month.Value, Day.Value), null, "MMMM d. yyyy");
            }
            else if (Year.HasValue && Month.HasValue)
            {
                var from = new DateTime(Year.Value, Month.Value, 1);
                ShowPostsByDate(from, from.AddMonths(1).AddMilliseconds(-1), "MMMM yyyy");
            }
            else if (Year.HasValue)
            {
                var from = new DateTime(Year.Value, 1, 1);
                ShowPostsByDate(from, from.AddYears(1).AddMilliseconds(-1), "yyyy");
            }
            else if (QueryCalendar != null || path.Contains("/calendar"))
            {
                // the calendar navigates between months with ?date=
                showCalendar = true;
                showPostList = false;
                title = Utils.Translate("calendar");
            }
            else if (!string.IsNullOrEmpty(QueryDate) && QueryDate.Length == 10)
            {
                ShowPostsByDate(DateTime.Parse(QueryDate, CultureInfo.InvariantCulture), null, "MMMM d. yyyy");
            }
        }
        catch (Exception ex) when (ex is ArgumentOutOfRangeException || ex is FormatException)
        {
            Navigation.NotFound();
            return;
        }

        metaDescription = BlogHead.MetaDescription(title + " - " + BlogSettings.Instance.Description);
    }

    private void ShowPostsByDate(DateTime from, DateTime? to, string titleFormat)
    {
        contentBy = ServingContentBy.DateRange;
        posts = Post.GetPostsByDate(from, to ?? from).ConvertAll(p => (IPublishable)p);
        title = from.ToString(titleFormat);
    }

    private void DisplayApmlFiltering()
    {
        if (Uri.TryCreate(QueryApml, UriKind.Absolute, out var url))
        {
            title = Utils.Translate("apmlFilteredList");
            try
            {
                var docs = Utils.FindSemanticDocuments(url, "apml");
                if (docs.Count > 0)
                {
                    foreach (var key in docs.Keys)
                    {
                        contentBy = ServingContentBy.Apml;
                        posts = BlogEngine.Core.Search.ApmlMatches(docs[key], 30).FindAll(p => p is Post);
                        posts.Sort((ip1, ip2) => ip2.DateCreated.CompareTo(ip1.DateCreated));
                        title += Utils.Translate("per") + key.Host;
                        break;
                    }
                }
                else
                {
                    ApmlError("apmlNotFoundDesc", "apmlNotFound");
                }
            }
            catch (NotSupportedException)
            {
                ApmlError("apmlNoInfoWebsite", "apmlNotFound");
            }
            catch (System.Net.WebException)
            {
                ApmlError("apmlNoConnWebsite", "apmlAddrInvalid");
            }
            catch (System.Net.Http.HttpRequestException)
            {
                ApmlError("apmlNoConnWebsite", "apmlAddrInvalid");
            }
            catch (XmlException)
            {
                ApmlError("apmlInvalidXml", "apmlDocErr");
            }
        }
        else if (posts == null || posts.Count == 0)
        {
            ApmlError("apmlInvalidUrl", "apmlNotFound");
        }
    }

    private void ApmlError(string message, string pageTitle)
    {
        errorHtml = "<h1 style=\"text-align:center\">" + Utils.Translate(message) + "</h1><br /><br />";
        title = Utils.Translate(pageTitle);
    }

    /// <summary>
    /// Old URL format with year= in the query string: permanent redirect to the date URL.
    /// </summary>
    private void RedirectOldDateUrl()
    {
        var page = string.IsNullOrEmpty(QueryPage) ? string.Empty : "?page=" + QueryPage;
        string rewrite = null;

        if (!string.IsNullOrEmpty(QueryDate) && DateTime.TryParse(QueryDate, CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            rewrite = $"{Utils.RelativeWebRoot}{date.Year}/{date.Month:00}/{date.Day:00}/default";
        }
        else if (!string.IsNullOrEmpty(QueryYear) && !string.IsNullOrEmpty(QueryMonth))
        {
            rewrite = $"{Utils.RelativeWebRoot}{QueryYear}/{QueryMonth}/default";
        }
        else if (!string.IsNullOrEmpty(QueryYear))
        {
            rewrite = $"{Utils.RelativeWebRoot}{QueryYear}/default";
        }

        if (rewrite != null)
        {
            HttpContext.Response.Redirect(rewrite + page, permanent: true);
        }
    }

    private void AddMetaKeywords()
    {
        if (Category.Categories.Count > 0)
        {
            metaKeywords = string.Join(",", Category.Categories.Select(c => c.Title));
        }
    }

    private static string StripExtension(string value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return value;
        }

        return value.EndsWith(".aspx", StringComparison.OrdinalIgnoreCase) ? value.Substring(0, value.Length - 5) : value;
    }
}
