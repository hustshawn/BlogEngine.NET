@page "/contact"
@page "/contact.aspx"
@layout PageLayout
@using System.ComponentModel.DataAnnotations
@using System.Net.Mail
@using System.Text.RegularExpressions
@using System.Web
@using BlogEngine.Core
@inject IHttpContextAccessor HttpContextAccessor

@* Port of contact.aspx (static SSR form post) *@

<BlogHead Title="@Utils.Translate("contact")" Description="@Utils.StripHtml(BlogSettings.Instance.ContactFormMessage)" />

<div id="contact" class="contact-page page-global">
    @if (!messageSent)
    {
        <div id="divForm" data-id="divForm">
            <h2 class="contact-page-title page-global-title">@Utils.Translate("contact")</h2>
            <div class="contact-page-message">@((MarkupString)BlogSettings.Instance.ContactFormMessage)</div>

            <EditForm Model="@contactModel" FormName="contact" method="post" enctype="multipart/form-data" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="txtName">@Utils.Translate("name")</label>
                    <InputText id="txtName" @bind-Value="contactModel.Name" class="field form-control" data-id="txtName" />
                    <ValidationMessage For="() => contactModel.Name" />
                </div>

                <div class="form-group">
                    <label for="txtEmail">@Utils.Translate("email")</label>
                    <InputText id="txtEmail" @bind-Value="contactModel.Email" class="field form-control" data-id="txtEmail" />
                    <ValidationMessage For="() => contactModel.Email" />
                </div>

                <div class="form-group">
                    <label for="txtSubject">@Utils.Translate("subject")</label>
                    <InputText id="txtSubject" @bind-Value="contactModel.Subject" class="field form-control" data-id="txtSubject" />
                    <ValidationMessage For="() => contactModel.Subject" />
                </div>

                <div class="form-group">
                    <label for="txtMessage">@Utils.Translate("message")</label>
                    <InputTextArea id="txtMessage" @bind-Value="contactModel.Message" class="form-control" rows="5" data-id="txtMessage" />
                    <ValidationMessage For="() => contactModel.Message" />
                </div>

                @if (BlogSettings.Instance.EnableContactAttachments)
                {
                    <div class="form-group">
                        <label for="txtAttachment">@Utils.Translate("attachFile")</label>
                        <input type="file" id="txtAttachment" name="txtAttachment" data-id="txtAttachment" />
                    </div>
                }

                @* REVIEW: Captcha integration — original used RecaptchaControl server control.
                   In Blazor, captcha should be implemented via JS interop with Google reCAPTCHA API. *@

                @if (!string.IsNullOrEmpty(statusMessage))
                {
                    <div class="alert alert-danger">@((MarkupString)statusMessage)</div>
                }

                @if (showCaptchaError)
                {
                    <div class="alert alert-warning">@Utils.Translate("captchaIncorrect")</div>
                }

                <div class="text-right btn-wrapper">
                    <button type="submit" class="btn btn-primary" data-id="btnSend">@Utils.Translate("send")</button>
                </div>
            </EditForm>
        </div>
    }

    <div id="thanks">
        @if (messageSent)
        {
            <div data-id="divThank">
                <div>@((MarkupString)BlogSettings.Instance.ContactThankMessage)</div>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromForm(FormName = "contact")]
    private ContactFormModel contactModel { get; set; }
    private bool messageSent = false;
    private string statusMessage = string.Empty;
    private bool showCaptchaError = false;
    private IFormFile attachmentFile;

    // Cookie-persisted data
    private string cookieUrl = string.Empty;
    private string cookieCountry = string.Empty;

    protected override void OnInitialized()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (contactModel != null)
        {
            // posted form: keep the cookie values used in the mail body
            GetCookie();
            return;
        }

        contactModel = new ContactFormModel();
        var queryString = httpContext?.Request.Query;

        // Pre-fill from query string
        if (queryString != null)
        {
            if (queryString.ContainsKey("subject"))
                contactModel.Subject = queryString["subject"];
            if (queryString.ContainsKey("name"))
                contactModel.Name = queryString["name"];
            if (queryString.ContainsKey("email"))
                contactModel.Email = queryString["email"];
        }

        // Get cookie data
        GetCookie();
    }

    private void GetCookie()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext?.Request.Cookies.ContainsKey("comment") == true)
        {
            // The original cookie used sub-values (HttpCookie.Values). In modern ASP.NET Core,
            // cookies are flat strings. We'll parse the composite cookie format if present.
            var cookieValue = httpContext.Request.Cookies["comment"];
            if (cookieValue != null)
            {
                var parts = HttpUtility.ParseQueryString(cookieValue);
                if (!string.IsNullOrEmpty(parts["name"]) && string.IsNullOrEmpty(contactModel.Name))
                    contactModel.Name = HttpUtility.UrlDecode(parts["name"]);
                if (!string.IsNullOrEmpty(parts["email"]) && string.IsNullOrEmpty(contactModel.Email))
                    contactModel.Email = parts["email"];
                cookieUrl = parts["url"] ?? string.Empty;
                cookieCountry = parts["country"] ?? string.Empty;
            }
        }
    }

    private void SetCookie()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null)
        {
            var cookieValue = $"name={HttpUtility.UrlEncode(contactModel.Name)}&email={contactModel.Email}&url=&country=";
            httpContext.Response.Cookies.Append("comment", cookieValue, new CookieOptions
            {
                Expires = DateTime.Now.AddMonths(24),
                Path = "/",
                SameSite = SameSiteMode.Lax
            });
        }
    }

    private void HandleSubmit()
    {
        var form = HttpContextAccessor.HttpContext?.Request;
        if (BlogSettings.Instance.EnableContactAttachments && form?.HasFormContentType == true)
        {
            attachmentFile = form.Form.Files["txtAttachment"];
        }

        showCaptchaError = false;
        statusMessage = string.Empty;

        // REVIEW: Captcha validation would be done here via JS interop if reCAPTCHA is enabled.
        // Original code: if (UseCaptcha && !IsCaptchaValid) { show error; return; }

        bool success = SendEmail(contactModel.Email, contactModel.Name, contactModel.Subject, contactModel.Message);
        if (success)
        {
            messageSent = true;
            SetCookie();
        }
        else
        {
            if (string.IsNullOrEmpty(statusMessage))
                statusMessage = BlogSettings.Instance.ContactErrorMessage;
        }
    }

    private bool SendEmail(string email, string name, string subject, string message)
    {
        try
        {
            using (MailMessage mail = new MailMessage())
            {
                mail.From = new MailAddress(BlogSettings.Instance.Email, name);
                mail.ReplyToList.Add(new MailAddress(email, name));
                mail.To.Add(BlogSettings.Instance.Email);
                mail.Subject = BlogSettings.Instance.EmailSubjectPrefix + " " + Utils.Translate("email").ToLower() + " - " + subject;

                mail.Body = "<div style=\"font: 11px verdana, arial\">";
                mail.Body += HttpUtility.HtmlEncode(message).Replace("\n", "<br />") + "<br /><br />";
                mail.Body += "<hr /><br />";
                mail.Body += "<h3>" + Utils.Translate("contactAuthorInformation") + "</h3>";
                mail.Body += "<div style=\"font-size:10px;line-height:16px\">";
                mail.Body += "<strong>" + Utils.Translate("name") + ":</strong> " + HttpUtility.HtmlEncode(name) + "<br />";
                mail.Body += "<strong>" + Utils.Translate("email") + ":</strong> " + HttpUtility.HtmlEncode(email) + "<br />";

                if (!string.IsNullOrEmpty(cookieUrl))
                    mail.Body += string.Format("<strong>" + Utils.Translate("website") + ":</strong> <a href=\"{0}\">{0}</a><br />", cookieUrl);

                if (!string.IsNullOrEmpty(cookieCountry))
                    mail.Body += "<strong>" + Utils.Translate("countryCode") + ":</strong> " + cookieCountry.ToUpperInvariant() + "<br />";

                var httpContext = HttpContextAccessor.HttpContext;
                if (httpContext != null)
                {
                    mail.Body += "<strong>" + Utils.Translate("contactIPAddress") + ":</strong> " + Utils.GetClientIP() + "<br />";
                    mail.Body += "<strong>" + Utils.Translate("contactUserAgent") + ":</strong> " + httpContext.Request.Headers["User-Agent"].ToString();
                }

                mail.Body += "</div></div>";
                mail.IsBodyHtml = true;

                // Handle file attachment
                if (attachmentFile != null && attachmentFile.Length > 0)
                {
                    var attachment = new Attachment(attachmentFile.OpenReadStream(), attachmentFile.FileName);
                    mail.Attachments.Add(attachment);
                }

                if (Utils.SendMailMessage(mail).Length > 0)
                {
                    return false;
                }
            }

            return true;
        }
        catch (Exception ex)
        {
            if (Security.IsAuthorizedTo(Rights.ViewDetailedErrorMessages))
            {
                statusMessage = System.Net.WebUtility.HtmlEncode(ex.InnerException != null ? ex.InnerException.Message : ex.Message);
            }
            return false;
        }
    }

    public class ContactFormModel
    {
        [Required(ErrorMessage = "Required")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Required")]
        [EmailAddress(ErrorMessage = "Enter a valid email")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Required")]
        public string Subject { get; set; } = string.Empty;

        [Required(ErrorMessage = "Required")]
        public string Message { get; set; } = string.Empty;
    }
}
