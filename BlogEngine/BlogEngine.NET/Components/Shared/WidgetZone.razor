@using BlogEngine.Core.DataStore
@using BlogEngine.NET.Components.Widgets
@using System.Xml

@* Port of AppCode/Controls/WidgetZone.cs: renders the widgets configured for the zone
   (App_Data/datastore/widgets/{ZoneName}.xml) *@

<div id="widgetzone_@zoneName" class="widgetzone">
    @foreach (var widget in widgets)
    {
        @if (widget.Type == null)
        {
            @((MarkupString)NotFound(widget.Name))
        }
        else
        {
            <WidgetErrorBoundary WidgetName="@widget.Name">
                <ChildContent>
                    <DynamicComponent Type="@widget.Type" Parameters="@widget.Parameters" />
                </ChildContent>
                <ErrorContent>
                    @((MarkupString)NotFound(widget.Name))
                </ErrorContent>
            </WidgetErrorBoundary>
        }
    }
</div>

@code {
    [Parameter] public string ZoneName { get; set; } = "be_WIDGET_ZONE";

    private string zoneName;
    private readonly List<WidgetInfo> widgets = new();

    private sealed class WidgetInfo
    {
        public string Name { get; init; }
        public Type Type { get; init; }
        public Dictionary<string, object> Parameters { get; init; }
    }

    protected override void OnParametersSet()
    {
        zoneName = Utils.RemoveIllegalCharacters(ZoneName);
        widgets.Clear();

        if (Blog.CurrentInstance.Cache[zoneName] is not XmlDocument doc)
        {
            doc = RetrieveXml(zoneName);
            if (doc != null)
            {
                Blog.CurrentInstance.Cache[zoneName] = doc;
            }
        }

        var zone = doc?.SelectNodes("//widget");
        if (zone == null)
        {
            return;
        }

        foreach (XmlNode node in zone)
        {
            var name = node.InnerText;
            var type = WidgetComponentBase.Resolve(name);
            if (type == null)
            {
                Utils.Log($"WidgetZone: widget {name} not found");
            }

            widgets.Add(new WidgetInfo
            {
                Name = name,
                Type = type,
                Parameters = new Dictionary<string, object>
                {
                    [nameof(WidgetComponentBase.Id)] = node.Attributes?["id"]?.Value,
                    [nameof(WidgetComponentBase.Name)] = name,
                    [nameof(WidgetComponentBase.Title)] = node.Attributes?["title"]?.Value
                }
            });
        }
    }

    private static string NotFound(string name) =>
        $"<p style=\"color:red\">Widget {System.Net.WebUtility.HtmlEncode(name)} not found, check log for details.<p>";

    private static XmlDocument RetrieveXml(string zoneName)
    {
        var ws = new WidgetSettings(zoneName) { SettingsBehavior = new XmlDocumentBehavior() };
        return (XmlDocument)ws.GetSettings();
    }
}
