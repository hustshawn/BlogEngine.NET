@using BlogEngine.Core
@using System.Text

<div class="widget @(WidgetName?.Replace(" ", string.Empty).ToLowerInvariant())" id="widget@(WidgetId)">
    @if (Security.IsAuthorizedTo(Rights.ManageWidgets))
    {
        @((MarkupString)AdminLinks)
    }
    @if (ShowTitle && !string.IsNullOrEmpty(WidgetTitle))
    {
        <h4>@WidgetTitle</h4>
    }
    <div class="content">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public string WidgetName { get; set; } = string.Empty;
    [Parameter] public Guid WidgetId { get; set; }
    [Parameter] public string WidgetTitle { get; set; } = string.Empty;
    [Parameter] public bool ShowTitle { get; set; } = true;

    private string AdminLinks
    {
        get
        {
            if (!Security.IsAuthorizedTo(Rights.ManageWidgets))
                return string.Empty;

            var sb = new StringBuilder();
            sb.AppendFormat("<a class=\"delete\" href=\"#\" onclick=\"BlogEngine.widgetAdmin.removeWidget('{0}');return false\" title=\"{1} widget\"><span class=\"widgetImg imgDelete\">&nbsp;</span></a>",
                WidgetId, Utils.Translate("delete"));
            sb.AppendFormat("<a class=\"edit\" href=\"#\" onclick=\"BlogEngine.widgetAdmin.editWidget('{0}', '{1}');return false\" title=\"{2} widget\"><span class=\"widgetImg imgEdit\">&nbsp;</span></a>",
                WidgetName, WidgetId, Utils.Translate("edit"));
            sb.AppendFormat("<a class=\"move\" href=\"#\" onclick=\"BlogEngine.widgetAdmin.initiateMoveWidget('{0}');return false\" title=\"{1} widget\"><span class=\"widgetImg imgMove\">&nbsp;</span></a>",
                WidgetId, Utils.Translate("move"));
            return sb.ToString();
        }
    }
}
