@using Microsoft.Extensions.Caching.Memory
@inject IMemoryCache MemoryCache

@* Port of AppCode/Controls/MonthList.cs (expand/collapse of the years via BlogEngine.toggleMonth in blog.js) *@

@if (months.Count == 0)
{
    <p>@Utils.Translate("none")</p>
}
else
{
    <ul id="monthList">
        @if (GroupByYear)
        {
            @foreach (var yearGroup in months.GroupBy(m => m.Key.Year))
            {
                <li class="year" onclick="BlogEngine.toggleMonth('year@(yearGroup.Key)')">@yearGroup.Key<ul id="year@(yearGroup.Key)" class="@(yearGroup.Key == DateTime.Now.Year ? "open" : null)">
                        @foreach (var item in yearGroup)
                        {
                            <li><a href="@GetMonthUrl(item.Key)">@item.Key.ToString("MMMM")</a> (@item.Value)</li>
                        }
                    </ul>
                </li>
            }
        }
        else
        {
            @foreach (var item in months)
            {
                <li><a href="@GetMonthUrl(item.Key)">@item.Key.ToString("MMMM yyyy")</a> (@item.Value)</li>
            }
        }
    </ul>
}

@code {
    [Parameter] public bool GroupByYear { get; set; } = true;
    [Parameter] public bool RecentDatesAtTop { get; set; }

    private SortedDictionary<DateTime, int> months = new();

    protected override void OnParametersSet()
    {
        var cacheKey = $"BE_MonthListCacheKey_{Blog.CurrentInstance.Id}_{RecentDatesAtTop}";
        if (!MemoryCache.TryGetValue(cacheKey, out SortedDictionary<DateTime, int> cached))
        {
            IComparer<DateTime> comparer = RecentDatesAtTop
                ? Comparer<DateTime>.Create((x, y) => -x.CompareTo(y))
                : Comparer<DateTime>.Default;

            cached = new SortedDictionary<DateTime, int>(comparer);
            foreach (var post in Post.ApplicablePosts.Where(p => p.IsVisibleToPublic))
            {
                var month = new DateTime(post.DateCreated.Year, post.DateCreated.Month, 1);
                cached.TryGetValue(month, out int count);
                cached[month] = count + 1;
            }

            MemoryCache.Set(cacheKey, cached, TimeSpan.FromHours(1));
        }
        months = cached;
    }

    private static string GetMonthUrl(DateTime date)
    {
        return $"{Utils.RelativeOrAbsoluteWebRoot}{date.Year}/{date:MM}/default{BlogConfig.FileExtension}";
    }
}
