@using BlogEngine.Core.Web.Controls
@* Port of Custom/Controls/PostList.ascx: renders the posts of the current page through the theme's PostView *@

@if (visible)
{
    <div id="posts" class="posts">
        @foreach (var view in views)
        {
            <DynamicComponent Type="@postViewType" Parameters="@(new Dictionary<string, object> { ["View"] = view })" />
        }
    </div>

    <div id="postPaging" style="display: none">
        @if (showPrev)
        {
            <a style="float:left">&lt;&lt; @Utils.Translate("previousPosts")</a>
        }
        <a style="float:right">@Utils.Translate("nextPosts") &gt;&gt;</a>
    </div>

    <div style="clear:both; display:block">
        <PostPager Posts="@posts" />
    </div>
}

@code {
    [CascadingParameter] public HttpContext HttpContext { get; set; }

    /// <summary>Posts to list; all applicable posts when null.</summary>
    [Parameter] public List<IPublishable> Posts { get; set; }

    /// <summary>The criteria by which the content is being served (by tag, category, author, etc).</summary>
    [Parameter] public ServingContentBy ContentBy { get; set; } = ServingContentBy.AllContent;

    private bool visible = true;
    private bool showPrev = true;
    private List<IPublishable> posts;
    private readonly List<PostViewBase> views = new();
    private Type postViewType;

    protected override void OnParametersSet()
    {
        views.Clear();
        visible = Security.IsAuthorizedTo(Rights.ViewPublicPosts);
        if (!visible)
        {
            return;
        }

        postViewType = Theme.Template("PostView");
        posts = Posts ?? Post.ApplicablePosts.ConvertAll(p => (IPublishable)p);

        if (posts.Count == 0)
        {
            showPrev = false;
            return;
        }

        var visiblePosts = posts.FindAll(p => p.IsVisible);
        var count = Math.Min(BlogSettings.Instance.PostsPerPage, visiblePosts.Count);
        var index = GetPageIndex() * count;
        var stop = count;
        if (index + count > visiblePosts.Count)
        {
            stop = visiblePosts.Count - index;
        }

        if (stop < 0 || stop + index > visiblePosts.Count)
        {
            showPrev = false;
            return;
        }

        var rawUrl = HttpContext == null ? string.Empty : HttpContext.Request.Path + HttpContext.Request.QueryString;
        var showExcerpt = ShowExcerpt(rawUrl);
        var counter = 0;
        foreach (var post in visiblePosts.GetRange(index, stop).OfType<Post>())
        {
            views.Add(new PostViewBase
            {
                Post = post,
                ShowExcerpt = showExcerpt,
                Location = ServingLocation.PostList,
                ContentBy = ContentBy,
                Index = counter++,
                RequestUrl = rawUrl
            });
        }

        if (index + stop >= visiblePosts.Count)
        {
            showPrev = false;
        }
    }

    private int GetPageIndex()
    {
        return int.TryParse(HttpContext?.Request.Query["page"], out var index) ? index - 1 : 0;
    }

    /// <summary>
    /// Whether or not to show the entire post or just the excerpt/description in the post list.
    /// </summary>
    private static bool ShowExcerpt(string rawUrl)
    {
        var url = rawUrl.ToUpperInvariant();
        var tagOrCategory = url.Contains("/CATEGORY/") || url.Contains("?TAG=/");

        return BlogSettings.Instance.ShowDescriptionInPostList ||
            (BlogSettings.Instance.ShowDescriptionInPostListForPostsByTagOrCategory && tagOrCategory);
    }
}
