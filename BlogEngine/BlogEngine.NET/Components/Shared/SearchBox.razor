@* Port of AppCode/Controls/SearchBox.cs (client-side search through BlogEngine.search in blog.js) *@

<div id="searchbox">
    <label for="searchfield" style="display:none">Search</label>
    <input type="text" value="@text" id="searchfield"
           onkeypress="if(event.keyCode==13) return BlogEngine.search('@Utils.RelativeWebRoot','searchfield')"
           onfocus="BlogEngine.searchClear('@EscapedText','searchfield')"
           onblur="BlogEngine.searchClear('@EscapedText','searchfield')" />
    <input type="button" value="@BlogSettings.Instance.SearchButtonText" id="searchbutton"
           onclick="BlogEngine.search('@Utils.RelativeWebRoot','searchfield');"
           onkeypress="BlogEngine.search('@Utils.RelativeWebRoot','searchfield');" />
    @if (BlogSettings.Instance.EnableCommentSearch && BlogSettings.Instance.ShowIncludeCommentsOption)
    {
        <div id="search-include-comments">
            <input type="checkbox" id="searchcomments" checked="@IncludeComments" />
            @if (!string.IsNullOrEmpty(BlogSettings.Instance.SearchCommentLabelText))
            {
                <label for="searchcomments">@BlogSettings.Instance.SearchCommentLabelText</label>
            }
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string Query { get; set; }
    [SupplyParameterFromQuery(Name = "comment")] public string Comment { get; set; }

    private string text;

    private string EscapedText => text.Replace("'", "\\'");

    private bool IncludeComments => Comment != null;

    protected override void OnParametersSet()
    {
        text = Query ?? BlogSettings.Instance.SearchDefaultText ?? string.Empty;
    }
}
