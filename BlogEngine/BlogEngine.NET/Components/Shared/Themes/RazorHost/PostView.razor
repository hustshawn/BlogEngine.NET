@using BlogEngine.Core

@* RazorHost theme PostView - dynamically renders themed content via Razor compilation *@
@* In the original, this used RazorHelpers.ParseRazor to compile .cshtml at runtime. *@
@* In modern .NET, we render via a service that loads themed templates. *@
@* Falls back to default rendering if no themed template is available. *@

@if (SinglePost)
{
    <article class="post-single" id="post@(Index)">
        <header class="post-header">
            <h1 class="post-title">@System.Net.WebUtility.HtmlEncode(Post.Title)</h1>
            <div class="post-meta">
                <span class="post-author"><a href="@(Utils.AbsoluteWebRoot + "author/" + Utils.RemoveIllegalCharacters(Post.Author + BlogConfig.FileExtension))">@(Post.AuthorProfile != null ? Utils.RemoveIllegalCharacters(Post.AuthorProfile.DisplayName) : Utils.RemoveIllegalCharacters(Post.Author))</a></span>
                <span class="post-date">@Post.DateCreated.ToString("MMM dd, yyyy")</span>
            </div>
        </header>
        <section class="post-body">
            @((MarkupString)Body)
        </section>
        <footer class="post-footer">
            @if (!string.IsNullOrEmpty(TagLinks))
            {
                <div class="post-tags">@((MarkupString)TagLinks)</div>
            }
            @if (!string.IsNullOrEmpty(AdminLinks))
            {
                <div class="post-adminlinks">@((MarkupString)AdminLinks)</div>
            }
        </footer>
    </article>
}
else
{
    <article class="post-home" id="post@(Index)">
        <header class="post-header">
            <h2 class="post-title">
                <a href="@Post.RelativeOrAbsoluteLink">@System.Net.WebUtility.HtmlEncode(Post.Title)</a>
            </h2>
            <div class="post-meta">
                <span class="post-date">@Post.DateCreated.ToString("MMM dd, yyyy")</span>
                <span class="post-author">@(Post.AuthorProfile != null ? Post.AuthorProfile.DisplayName : Post.Author)</span>
            </div>
        </header>
        <section class="post-body">
            @((MarkupString)Body)
        </section>
    </article>
}

@code {
    [Parameter] public Post Post { get; set; }
    [Parameter] public int Index { get; set; }
    [Parameter] public bool SinglePost { get; set; }
    [Parameter] public string Body { get; set; } = "";
    [Parameter] public string AdminLinks { get; set; } = "";
    [Parameter] public string CategoryLinks { get; set; } = "";
    [Parameter] public string TagLinks { get; set; } = "";
    // REVIEW: RazorHost originally compiled .cshtml dynamically via BuildManager.GetCompiledType — 
    // verify that themed .cshtml templates are handled by the theme engine or that this fallback rendering is acceptable
}
