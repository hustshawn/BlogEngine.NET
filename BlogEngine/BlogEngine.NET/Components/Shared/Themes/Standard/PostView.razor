@inherits PostViewTemplate
@* Port of Custom/Themes/Standard/PostView.ascx *@

@if (!SinglePost)
{
    <article class="post-home post-home-@postImagePosition" id="post@(View.Index)">
        <div class="post-home-inner">
            @if (Post.FirstImgSrc.Length > 1)
            {
                <a class="post-cover" href="@Post.RelativeOrAbsoluteLink"><img src="@Post.FirstImgSrc" alt="@Post.Title"></a>
            }
            <header class="post-header">
                <div class="post-meta">
                    <span class="post-author"><i class="fa fa-user"></i> <a href="@AuthorUrl">@AuthorName</a></span>
                    <span class="post-date"><i class="fa fa-clock-o"></i> @Post.DateCreated.ToString("MMM dd, yyyy")</span>
                    @if (postCategory.Length > 0)
                    {
                        <span class="post-category"><i class="fa fa-folder-open"></i> @((MarkupString)postCategory)</span>
                    }
                </div>
                <h2 class="post-title"><a class="post-link" href="@Post.RelativeOrAbsoluteLink">@Post.Title</a></h2>
            </header>
            <p class="post-description">
                @((MarkupString)(Post.Description ?? string.Empty))...
            </p>
            <a href="@Post.RelativeOrAbsoluteLink" class="btn btn-outline-dark post-more">read more</a>
        </div>
    </article>
}
else
{
    <article class="post-single @(Post.FirstImgSrc.Length < 1 ? " no-thumbnail" : "")" id="post@(View.Index)">
        <header class="post-header">
            <h1 class="post-title">@Post.Title</h1>
            <div class="post-meta">
                <span class="post-author"><i class="fa fa-user"></i> <a href="@AuthorUrl">@AuthorName</a></span>
                <span class="post-date"><i class="fa fa-clock-o"></i> @Post.DateCreated.ToString("MMM dd, yyyy")</span>
                @if (postCategory.Length > 0)
                {
                    <span class="post-category"><i class="fa fa-folder-open"></i> @((MarkupString)postCategory)</span>
                }
                <div class="dropdown post-share float-md-right">
                    <a class="dropdown-toggle" href="#" role="button" id="dropdownMenuLink" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"><i class="fa fa-share-alt"></i>@Utils.Translate("share")</a>
                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenuLink">
                        <a class="dropdown-item item-fb" href="https://www.addtoany.com/add_to/facebook?linkurl=@(Post.AbsoluteLink)&linkname=@Post.Title" target="_blank"><i class="fa fa-facebook-square"></i>Facebook</a>
                        <a class="dropdown-item item-tw" href="https://www.addtoany.com/add_to/twitter?linkurl=@(Post.AbsoluteLink)&linkname=@Post.Title" target="_blank"><i class="fa fa-twitter-square"></i>Twitter</a>
                        <a class="dropdown-item item-gp" href="https://www.addtoany.com/add_to/google_plus?linkurl=@(Post.AbsoluteLink)&linkname=@Post.Title" target="_blank"><i class="fa fa-google-plus-square"></i>Google +</a>
                        <a class="dropdown-item item-ln" href="https://www.addtoany.com/add_to/linkedin?linkurl=@(Post.AbsoluteLink)&linkname=@Post.Title" target="_blank"><i class="fa fa-linkedin-square"></i>LinkedIn</a>
                        <a class="dropdown-item item-pi" href="https://www.addtoany.com/add_to/pinterest?linkurl=@(Post.AbsoluteLink)&linkname=@Post.Title" target="_blank"><i class="fa fa-pinterest-square"></i>Pinterest</a>
                        <a class="dropdown-item item-em" href="https://www.addtoany.com/add_to/email?linkurl=@(Post.AbsoluteLink)&linkname=@Post.Title" target="_blank"><i class="fa fa-envelope-square"></i>Email</a>
                        <a class="dropdown-item item-em" href="https://www.addtoany.com/share?linkurl=@(Post.AbsoluteLink)&linkname=@Post.Title" target="_blank"><i class="fa fa-plus-square"></i>@Utils.Translate("share")...</a>
                    </div>
                </div>
            </div>
        </header>
        <section class="post-body content-stlye">
            @((MarkupString)Body)
        </section>
        <footer class="post-footer">
            <div class="post-tags">@((MarkupString)(View.TagLinks(", ") ?? string.Empty))</div>
            @if (AdminLinks.Length > 0)
            {
                <div class="post-adminlinks">@((MarkupString)AdminLinks)</div>
            }
        </footer>
    </article>
    <script type="application/ld+json">
    {
      "@@context": "http://schema.org",
      "@@type": "NewsArticle",
      "mainEntityOfPage": {
        "@@type": "WebPage",
        "@@id": "@Post.AbsoluteLink"
      },
      "headline": "@Post.Title",
      @if (Post.FirstImgSrc.Length > 1)
      {
          @((MarkupString)$"\"image\": \"{Utils.AbsoluteWebRoot + Post.FirstImgSrc.TrimStart(' ', '/')}\",")
      }
      "datePublished": "@Post.DateCreated.ToString("yyyy-MM-dd")",
      "dateModified": "@Post.DateModified.ToString("yyyy-MM-dd")",
      "author": {
        "@@type": "Person",
        "name": "@AuthorName"
      },
       "publisher": {
        "@@type": "Organization",
        "name": "@BlogSettings.Instance.Name",
        "logo": {
          "@@type": "ImageObject",
          "url": "@Theme.Field("Publisher Logo", "http://exampleblog.com/logo.png")"
        }
      },
      "description": "@Utils.RemoveHtmlWhitespace(Post.Description)"
    }
    </script>
}

@code {
    private string postCategory = string.Empty;
    private string postImagePosition = "top";

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        postCategory = View.CategoryLinks(", ");
        postImagePosition = Theme.Field("Post Thumbnail position", "top");
    }
}
