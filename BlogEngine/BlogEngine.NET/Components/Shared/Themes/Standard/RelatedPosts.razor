@inherits RelatedPostsTemplate
@* Port of Custom/Themes/Standard/RelatedPosts.ascx *@

<div id="relatedPosts" class="well-global">
    <h3 class="well-global-title">@Utils.Translate("relatedPosts")</h3>
    <ul class="related-posts">
        @foreach (var item in RelatedPostList)
        {
            <li class="related-posts-item">
                <a href="@item.Link">@((MarkupString)item.Title)</a>
                <p>@((MarkupString)item.Description)</p>
            </li>
        }
    </ul>
</div>
