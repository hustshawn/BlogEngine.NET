@inherits CommentViewTemplate
@* Port of Custom/Themes/Standard/CommentView.ascx *@

<ul id="id_@Comment.Id">
    <li class="comment-item">
        <div class="comment-content @(Post.Author.Equals(Comment.Author, StringComparison.OrdinalIgnoreCase) ? " self" : "")">
            @((MarkupString)View.Gravatar(48))
            <div class="comment-author">
                @if (Comment.Website != null)
                {
                    <a href="@Comment.Website" rel="nofollow" class="url fn">@((MarkupString)Comment.Author)</a>
                }
                else
                {
                    <a class="fn">@((MarkupString)Comment.Author)</a>
                }
            </div>
            <div class="comment-text">
                @((MarkupString)Text)
            </div>
            <div class="comment-replylink">
                <span>@Comment.DateCreated.ToString("dd MMMM yyyy")</span> - @((MarkupString)ReplyToLink)
            </div>
            <div class="comment-adminlinks">
                @((MarkupString)(AdminLinks.Length > 2 ? AdminLinks.Substring(2) : AdminLinks))
            </div>
        </div>
        <div id="replies_@Comment.Id" style="@(HideReplies ? "display:none;" : null)">
            @ChildContent
        </div>
    </li>
</ul>
