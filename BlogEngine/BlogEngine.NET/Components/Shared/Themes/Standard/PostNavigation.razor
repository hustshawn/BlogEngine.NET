@inherits PostNavigationTemplate
@* Port of Custom/Themes/Standard/PostNavigation.ascx *@

<div id="postnavigation" class="navigation-posts row">
    <div class="col-6 text-left prev-post">
        @if (!string.IsNullOrEmpty(View.PreviousPostUrl))
        {
            <a href="@View.PreviousPostUrl" class="nav-prev"><i class="fa fa-chevron-left"></i> Previous Post</a>
        }
    </div>
    <div class="col-6 text-right next-post">
        @if (!string.IsNullOrEmpty(View.NextPostUrl))
        {
            <a href="@View.NextPostUrl" class="nav-next">Next Post <i class="fa fa-chevron-right"></i></a>
        }
    </div>
</div>
