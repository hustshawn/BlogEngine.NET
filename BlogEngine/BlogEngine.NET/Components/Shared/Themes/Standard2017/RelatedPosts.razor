@inherits RelatedPostsTemplate
@* Port of Custom/Themes/Standard-2017/RelatedPosts.ascx *@

<div id="relatedPosts" class="related-posts well-global">
    <h3 class="well-global-title">@Utils.Translate("relatedPosts")</h3>
    <ul class="list-unstyled">
        @foreach (var item in RelatedPostList)
        {
            <li>
                <a href="@item.Link">@((MarkupString)item.Title)</a>
                <div><small class="text-muted">@((MarkupString)item.Description)</small></div>
            </li>
        }
    </ul>
</div>
