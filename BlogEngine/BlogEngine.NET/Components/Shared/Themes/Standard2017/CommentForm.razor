@inherits CommentFormTemplate
@* Port of Custom/Themes/Standard-2017/CommentForm.ascx (fields are posted by the CommentList form) *@

<div class="comment-form well-global">
    <h3 class="well-global-title" id="addcomment">@Utils.Translate("addComment")</h3>
    <div class="form-group">
        <input type="text" class="form-control" placeholder="@Utils.Translate("name")" name="txtName" id="txtName" value="@Values.Name" />
    </div>
    <div class="form-group">
        <input type="text" placeholder="@Utils.Translate("email")" class="form-control" name="txtEmail" id="txtEmail" value="@Values.Email" />
        <span id="gravatarmsg"></span>
    </div>
    @if (BlogSettings.Instance.EnableWebsiteInComments)
    {
        <div class="form-group">
            <input type="text" placeholder="@Utils.Translate("website") (optional)" class="form-control" name="txtWebsite" id="txtWebsite" value="@Values.Website" />
        </div>
    }
    <div class="form-group" id="commentCompose">
        <textarea class="form-control" id="txtContent" placeholder="@Utils.Translate("comment")" cols="50" rows="7" name="txtContent">@Values.Content</textarea>
    </div>
    @if (BlogSettings.Instance.ShowLivePreview)
    {
        <div class="form-group comment-preview">
            <label>@Utils.Translate("previewComment")</label>
            <div id="commentPreview">
                <img src="@(Utils.RelativeWebRoot)Content/images/blog/ajax-loader.gif" style="display: none" alt="Loading" />
            </div>
        </div>
    }
    <div id="commentCaptcha" class="form-group"></div>
    <div class="form-group">
        <label>
            <input type="checkbox" id="cbNotify" name="cbNotify" value="true" checked="@Values.Notify" />
            @Utils.Translate("notifyOnNewComments")
        </label>
    </div>
    <input type="submit" id="btnSaveAjax" value="@Utils.Translate("saveComment")" class="btn btn-primary btn-block" onclick="return BlogEngine.validateAndSubmitCommentForm()" />
</div>
