@inherits PostViewTemplate
@* Port of Custom/Themes/Standard-2017/PostView.ascx *@

<article class="post" id="post@(View.Index)">
    <header class="post-header">
        <h2 class="post-title">
            <a href="@Post.RelativeOrAbsoluteLink">@Post.Title</a>
        </h2>
        <div class="post-info clearfix">
            <span class="post-date">@Post.DateCreated.ToString("dd MMMM yyyy")</span>
            <span class="post-author"><a href="@AuthorUrl">@AuthorName</a></span>
            <span class="post-category">@((MarkupString)View.CategoryLinks(", "))</span>
        </div>
    </header>
    <section class="post-body text">
        @((MarkupString)Body)
    </section>
    @if (SinglePost)
    {
        <footer class="post-footer">
            <div class="post-tags">
                @Utils.Translate("tags") : @((MarkupString)(View.TagLinks(", ") ?? string.Empty))
            </div>
            <div class="post-rating">
                @((MarkupString)View.Rating)
            </div>
            <div class="post-adminlinks">@((MarkupString)AdminLinks)</div>
        </footer>
    }
</article>
