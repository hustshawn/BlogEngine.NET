@inherits PostNavigationTemplate
@* Port of Custom/Themes/Standard-2017/PostNavigation.ascx *@

<div id="postnavigation" class="navigation-posts well-global clearfix">
    <div class="text-left next-post">
        @if (!string.IsNullOrEmpty(View.NextPostUrl))
        {
            <a href="@View.NextPostUrl" class="nav-next">&larr; @View.NextPostTitle </a>
        }
    </div>
    <div class="text-right prev-post ">
        @if (!string.IsNullOrEmpty(View.PreviousPostUrl))
        {
            <a href="@View.PreviousPostUrl" class="nav-prev">@View.PreviousPostTitle &rarr;</a>
        }
    </div>
</div>
