@inherits CommentFormTemplate
@* Port of Custom/Controls/Defaults/CommentForm.ascx (fields are posted by the CommentList form) *@

<div class="commentForm">
    <h3 id="addcomment">@Utils.Translate("addComment")</h3>
    <p>
        <label for="txtName" class="lbl-user">@Utils.Translate("name")*</label>
        <input type="text" class="txt-user" name="txtName" id="txtName" tabindex="2" value="@Values.Name" />
    </p>
    <p>
        <label for="txtEmail" class="lbl-email">@Utils.Translate("email")*</label>
        <input type="text" class="txt-email" name="txtEmail" id="txtEmail" tabindex="3" value="@Values.Email" />
        <span id="gravatarmsg"></span>
    </p>
    <p>
        <label for="txtWebsite" class="lbl-website">@Utils.Translate("website")</label>
        <input type="text" class="txt-website" name="txtWebsite" id="txtWebsite" tabindex="4" value="@Values.Website" />
    </p>
    <p>
        <label for="txtContent" class="lbl-content">@Utils.Translate("comment")*</label>
        <textarea class="txt-content" tabindex="7" id="txtContent" cols="50" rows="10" name="txtContent">@Values.Content</textarea>
    </p>
    <p>
        <input type="checkbox" id="cbNotify" name="cbNotify" value="true" checked="@Values.Notify" class="cmnt-frm-notify" style="width: auto" tabindex="8" />
        <label for="cbNotify" style="width: auto; float: none; display: inline; padding-left: 5px">@Utils.Translate("notifyOnNewComments")</label>
    </p>
    <p>
        <input type="submit" id="btnSaveAjax" class="btn-save" style="margin-top: 10px" value="@Utils.Translate("saveComment")" onclick="return BlogEngine.validateAndSubmitCommentForm()" tabindex="10" />
    </p>
</div>
