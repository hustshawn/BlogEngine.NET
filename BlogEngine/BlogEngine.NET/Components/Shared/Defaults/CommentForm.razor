@using BlogEngine.Core

<div class="commentForm">
    <h3 id="addcomment">@Utils.Translate("addComment")</h3>
    <p>
        <label for="txtName" class="lbl-user">@Utils.Translate("name")*</label>
        <input type="text" class="txt-user" id="txtName" tabindex="2" @bind="authorName" />
    </p>
    <p>
        <label for="txtEmail" class="lbl-email">@Utils.Translate("email")*</label>
        <input type="text" class="txt-email" id="txtEmail" tabindex="3" @bind="email" />
        <span id="gravatarmsg"></span>
    </p>
    <p>
        <label for="txtWebsite" class="lbl-website">@Utils.Translate("website")</label>
        <input type="text" class="txt-website" id="txtWebsite" tabindex="4" @bind="website" />
    </p>
    <p>
        <label for="txtContent" class="lbl-content">@Utils.Translate("comment")*</label>
        <textarea class="txt-content" tabindex="7" id="txtContent" cols="50" rows="10" @bind="content"></textarea>
    </p>
    <p>
        <input type="checkbox" id="cbNotify" class="cmnt-frm-notify" style="width: auto" tabindex="8" @bind="notify" />
        <label for="cbNotify" style="width: auto; float: none; display: inline; padding-left: 5px">@Utils.Translate("notifyOnNewComments")</label>
    </p>
    @if (!string.IsNullOrEmpty(validationMessage))
    {
        <p style="color:red">@validationMessage</p>
    }
    <p>
        <button type="button" id="btnSaveAjax" class="btn-save" style="margin-top: 10px"
                @onclick="SubmitComment" tabindex="10">@Utils.Translate("saveComment")</button>
    </p>
</div>

@code {
    [Parameter] public Post PostItem { get; set; }
    [Parameter] public EventCallback<CommentList.CommentSubmission> OnCommentSubmitted { get; set; }

    private string authorName = string.Empty;
    private string email = string.Empty;
    private string website = string.Empty;
    private string content = string.Empty;
    private bool notify = false;
    private string validationMessage = string.Empty;

    private async Task SubmitComment()
    {
        validationMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(authorName))
        {
            validationMessage = $"{Utils.Translate("name")} is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(email))
        {
            validationMessage = $"{Utils.Translate("email")} is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(content))
        {
            validationMessage = $"{Utils.Translate("comment")} is required.";
            return;
        }

        var submission = new CommentList.CommentSubmission
        {
            Author = authorName,
            Email = email,
            Website = website,
            Country = string.Empty,
            Content = content,
            Notify = notify
        };

        await OnCommentSubmitted.InvokeAsync(submission);

        // Clear form after submission
        authorName = string.Empty;
        email = string.Empty;
        website = string.Empty;
        content = string.Empty;
        notify = false;
    }
}
