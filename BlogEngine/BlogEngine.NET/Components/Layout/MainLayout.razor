@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IConfiguration Configuration

@* MainLayout.razor — converted from Custom/Themes/Standard/site.master *@

<div class="@langDirection">
    <!-- START HEADER -->
    <header class="blog-header container">
        <nav class="d-flex">
            <h1 class="blog-logo my-auto">
                <a href="@absoluteWebRoot">
                    @blogName
                </a>
            </h1>
            <button class="blog-nav-toggle hamburger ml-auto my-auto color-dark hamburger--squeeze" type="button">
                <span class="hamburger-box">
                    <span class="hamburger-inner"></span>
                </span>
            </button>
        </nav>
    </header>
    <!-- END HEADER -->

    <!-- START CONTENT -->
    <div class="container blog-content">
        @Body
    </div>
    <!-- END CONTENT -->

    <div class="blog-sidebar">
        <div class="blog-sidebar-inner">
            <ul class="blog-nav">
                <li><a href="@absoluteWebRoot">@homeLabel</a></li>
                @foreach (var parentPage in GetVisibleParentPages())
                {
                    <li>
                        <a href="@parentPage.RelativeLink">@parentPage.Title</a>
                        @if (parentPage.HasChildPages)
                        {
                            <ul>
                                @foreach (var childPage in GetVisibleChildPages(parentPage.Id))
                                {
                                    <li>
                                        <a href="@childPage.RelativeLink">@childPage.Title</a>
                                    </li>
                                }
                            </ul>
                        }
                    </li>
                }
                <li><a href="@(absoluteWebRoot + "archive")">@archiveLabel</a></li>
                <li><a href="@(absoluteWebRoot + "contact")">@contactLabel</a></li>
                <li><a href="@loginHref"><span>@loginText</span></a></li>
            </ul>
            @* REVIEW: WidgetZone "sidebar Post" — widget system must be migrated to render here *@
            @* <WidgetZone ZoneName="sidebar Post" /> *@
        </div>
    </div>

    <div class="overlay"></div>

    <!-- START FOOTER -->
    <div class="container container-footer">
        <footer class="blog-footer">
            <ul class="nav blog-social mx-auto justify-content-center">
                <li><a class="item-fb" data-toggle="tooltip" title="follow on Facebook" target="_blank" href="@GetCustomField("Facebook Account", "#/")" rel="external nofollow"><i class="fa fa-facebook"></i></a></li>
                <li><a class="item-tw" data-toggle="tooltip" title="follow on Twitter" target="_blank" href="@GetCustomField("Twitter Account", "#/")" rel="external nofollow"><i class="fa fa-twitter"></i></a></li>
                <li><a class="item-gp" data-toggle="tooltip" title="follow on Google +" target="_blank" href="@GetCustomField("Google Plus Account", "#/")" rel="external nofollow"><i class="fa fa-google-plus"></i></a></li>
                <li><a class="item-li" data-toggle="tooltip" title="follow on Linkedin" target="_blank" href="@GetCustomField("Linkedin Account", "#/")" rel="external nofollow"><i class="fa fa-linkedin"></i></a></li>
                <li><a class="item-in" data-toggle="tooltip" title="follow on Instagram" target="_blank" href="@GetCustomField("Instagramm Account", "#/")" rel="external nofollow"><i class="fa fa-instagram"></i></a></li>
                <li><a class="item-yt" data-toggle="tooltip" title="follow on YouTube" target="_blank" href="@GetCustomField("Youtube Account", "/")" rel="external nofollow"><i class="fa fa-youtube"></i></a></li>
                <li><a class="item-pi" data-toggle="tooltip" title="follow on Pinterest" target="_blank" href="@GetCustomField("Pinterest Account", "/")" rel="external nofollow"><i class="fa fa-pinterest"></i></a></li>
                <li><a class="item-gb" data-toggle="tooltip" title="follow on GitHub" target="_blank" href="@GetCustomField("Github Account", "/")" rel="external nofollow"><i class="fa fa-git"></i></a></li>
            </ul>
            <div class="blog-copyright mx-auto mt-3 text-center">
                <span class="d-block">&copy; @DateTime.Now.Year</span>
                <span>Designed by <a href="http://blogengine.io/themes/" rel="nofollow" target="_blank">BlogEngine</a></span>
            </div>
        </footer>
    </div>
    <!-- END FOOTER -->

    <i class="goup fa fa-chevron-up"></i>
</div>

@code {
    private string blogName = string.Empty;
    private string absoluteWebRoot = "/";
    private string relativeWebRoot = "/";
    private string langDirection = "ltr";
    private string loginText = "Login";
    private string loginHref = "/Account/login";
    private string homeLabel = "Home";
    private string archiveLabel = "Archive";
    private string contactLabel = "Contact";

    protected override void OnInitialized()
    {
        blogName = BlogSettings.Instance.Name;
        absoluteWebRoot = Utils.AbsoluteWebRoot.ToString();
        relativeWebRoot = Utils.RelativeWebRoot;
        langDirection = Utils.Translate("LangDirection", "ltr");
        homeLabel = Utils.Translate("home", "Home");
        archiveLabel = Utils.Translate("archive", "Archive");
        contactLabel = Utils.Translate("contact", "Contact");

        if (Security.IsAuthenticated)
        {
            loginText = Utils.Translate("admin", "Admin");
            loginHref = relativeWebRoot + "admin/";
        }
        else
        {
            loginText = Utils.Translate("login", "Login");
            loginHref = relativeWebRoot + "Account/login?ReturnURL=" + relativeWebRoot + "admin/";
        }
    }

    private IEnumerable<BlogEngine.Core.Page> GetVisibleParentPages()
    {
        return BlogEngine.Core.Page.Pages
            .Where(p => !p.HasParentPage && p.IsPublished && p.ShowInList);
    }

    private IEnumerable<BlogEngine.Core.Page> GetVisibleChildPages(Guid parentId)
    {
        return BlogEngine.Core.Page.Pages
            .Where(p => p.Parent == parentId && p.IsPublished && p.ShowInList);
    }

    /// <summary>
    /// Returns a custom field value for the Standard theme, or the default if not found.
    /// </summary>
    private string GetCustomField(string fieldName, string defaultValue)
    {
        // REVIEW: behavior inferred from usage — the original site.master used
        // [CUSTOMFIELD|THEME|Standard|fieldName|defaultValue/] placeholders that were
        // resolved by BlogEngine.Core's custom field system at render time.
        // This attempts the same lookup via the CustomField API.
        try
        {
            var field = BlogEngine.Core.Providers.BlogService.FillCustomFields()
                .FirstOrDefault(f => f.CustomType == "THEME" &&
                                     f.BlogId == Blog.CurrentInstance.Id &&
                                     f.ObjectId == "Standard" &&
                                     f.Key == fieldName);
            return field != null && !string.IsNullOrEmpty(field.Value) ? field.Value : defaultValue;
        }
        catch
        {
            return defaultValue;
        }
    }
}
