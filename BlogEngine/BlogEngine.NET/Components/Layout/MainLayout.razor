@inherits LayoutComponentBase

@* Renders the current theme's site.master (Components/Shared/Themes/{Theme}/SiteMaster.razor) *@
<DynamicComponent Type="@Theme.Master" Parameters="@parameters" />

@code {
    /// <summary>
    /// True for pages that used the theme's page.master in the original (archive, contact, page, search, errors).
    /// </summary>
    protected virtual bool IsPageLayout => false;

    private Dictionary<string, object> parameters;

    protected override void OnParametersSet()
    {
        parameters = new Dictionary<string, object>
        {
            ["Body"] = Body,
            ["IsPageLayout"] = IsPageLayout
        };
    }
}
