@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Sections
@using BlogEngine.NET.Components.Pages.Account

@* AccountLayout.razor — converted from Account/account.master (static SSR).
   Pages report status messages (the original master's SetStatus) through the
   AccountStatus component, which renders into the "account-status" section below. *@

<HeadContent>
    <meta name="description" content="Account Login Membership User Password" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:400,500" rel="stylesheet" />
    <link href="Account/account.css" rel="stylesheet" />
</HeadContent>

<div class="@Utils.Translate("LangDirection", "ltr")">
    <div class="account">
        <div class="account-header text-center">
            <a href="https://blogengine.io/" target="_blank" rel="noopener">
                <img alt="BlogEngine.NET" src="Content/images/blog/logo.png" />
            </a>
        </div>
        <div id="StatusBox">
            <SectionOutlet SectionName="@AccountStatus.SectionName" />
        </div>
        <div class="account-box">
            @Body
        </div>
    </div>
</div>
