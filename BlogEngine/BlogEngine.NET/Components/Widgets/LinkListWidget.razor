@inherits WidgetComponentBase
@* Port of Custom/Widgets/LinkList/widget.cshtml *@

<div class="Widget widget linklist">
    <h4 class="WidgetHeader widget-header">@Title</h4>
    <div class="WidgetContent widget-content">
        <ul id="linkList" class="linklist">
            @foreach (var link in links)
            {
                if (link.Target == "on")
                {
                    <li><a href="@link.Url" title="@link.Title" target="_blank">@link.Title</a></li>
                }
                else
                {
                    <li><a href="@link.Url" title="@link.Title">@link.Title</a></li>
                }
            }
            @if (links.Count == 0)
            {
                <li>@Utils.Translate("empty")</li>
            }
        </ul>
    </div>
</div>

@code {
    private List<BlogEngine.NET.Custom.Widgets.LinkItem> links = new();

    protected override void OnParametersSet()
    {
        links = new BlogEngine.NET.Custom.Widgets.LinkList(Id).GetLinks();
    }
}
