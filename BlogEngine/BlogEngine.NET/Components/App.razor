@using System.Reflection
@using Microsoft.AspNetCore.Components.Endpoints
@using BlogEngine.NET.Components.Layout

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @if (IsBlogPage)
    {
        @* Public pages use absolute URLs (like the original theme masters), so no <base> element:
           it would break in-page anchors (href="#comment") and relative links inside post content. *@
        <SiteHead />
    }
    else
    {
        <base href="/" />
    }
    <HeadOutlet />
</head>
<body class="@(IsBlogPage ? Utils.Translate("LangDirection", "ltr") : null)">
    <Routes />
    @if (!IsBlogPage)
    {
        <script src="_framework/blazor.web.js"></script>
    }
</body>
</html>

@code {
    [CascadingParameter]
    public HttpContext HttpContext { get; set; }

    /// <summary>
    /// True when the endpoint renders a public blog page (MainLayout / PageLayout, i.e. the theme masters).
    /// Admin and account pages have their own layouts and head content.
    /// </summary>
    private bool IsBlogPage
    {
        get
        {
            var page = HttpContext?.GetEndpoint()?.Metadata.GetMetadata<ComponentTypeMetadata>()?.Type;
            if (page == null)
            {
                return true;
            }

            var layout = page.GetCustomAttribute<LayoutAttribute>()?.LayoutType;
            return layout == null || typeof(MainLayout).IsAssignableFrom(layout) || typeof(PageLayout).IsAssignableFrom(layout);
        }
    }
}
