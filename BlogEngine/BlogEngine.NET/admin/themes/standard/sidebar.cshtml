@{
    var name = Security.CurrentUser.Identity.Name;
    var src = Utils.ApplicationRelativeWebRoot + "Content/images/blog/noavatar.jpg";
    var displayName = "Anonymous";

    var profile = AuthorProfile.GetProfile(name);
    if (profile != null)
    {
        if (!string.IsNullOrEmpty(profile.PhotoUrl))
        {
            src = Utils.ApplicationRelativeWebRoot + "image.axd?picture=/avatars/" + profile.PhotoUrl;
        }
        displayName = profile.DisplayName;
    }
}
<div class="nav-user">
    <div class="nav-user-info">
        <div class="nav-user-img"><img src="@src" /></div>
        <div class="nav-user-name text-ellipsis">@displayName</div>
    </div>
    <ul class="nav-user-actions clearfix">
        <li title="@Utils.Translate("logoff")"><a href="{{SiteVars.RelativeWebRoot}}Account/logout"><i class="fa fa-power-off"></i></a></li>
        <li title="@Utils.Translate("changePassword")"><a href="{{SiteVars.RelativeWebRoot}}Account/change-password" target="_blank"><i class="fa fa-key"></i></a></li>
        <li title="@Utils.Translate("profile")"><a href="{{SiteVars.RelativeWebRoot}}admin/#/security/profile"><i class="fa fa-user"></i></a></li>
        <li title="@Utils.Translate("viewMyBlog")"><a href="{{SiteVars.RelativeWebRoot}}" target="_blank"><i class="fa fa-globe"></i></a></li>
    </ul>
</div>
<div class="nav-sidebar">
    <ul data-ng-controller="NavController">
        @if (Security.IsAuthorizedTo(Rights.ViewDashboard))
        {
            <li id="mu-dashboard" class="active"><a href="{{SiteVars.RelativeWebRoot}}admin/#/dashboard"><i class="fa fa-th-large"></i> @Utils.Translate("dashboard")</a></li>
        }
        <li id="mu-content">
            <a href="{{SiteVars.RelativeWebRoot}}admin/#/content/posts"><i class="fa fa-align-justify"></i> @Utils.Translate("content")</a>
            <ul class="sub-nav-sidebar">
                <li id="mu-posts" data-ng-class="{ active: isActive('/content/posts')}"><a href="{{SiteVars.RelativeWebRoot}}admin/#/content/posts">@Utils.Translate("posts")</a></li>
                @if (BlogSettings.Instance.CommentProvider == BlogSettings.CommentsBy.BlogEngine)
            {
                    <li id="mu-comments" data-ng-class="{ active: isActive('/content/comments')}"><a href="{{SiteVars.RelativeWebRoot}}admin/#/content/comments">@Utils.Translate("comments")</a></li>
                }
                <li id="mu-pages" data-ng-class="{ active: isActive('/content/pages')}"><a href="{{SiteVars.RelativeWebRoot}}admin/#/content/pages">@Utils.Translate("pages")</a></li>
                <li data-ng-class="{ active: isActive('/content/categories')}"><a href="{{SiteVars.RelativeWebRoot}}admin/#/content/categories">@Utils.Translate("categories")</a></li>
                <li data-ng-class="{ active: isActive('/content/tags')}"><a href="{{SiteVars.RelativeWebRoot}}admin/#/content/tags">@Utils.Translate("tags")</a></li>
                @if (Blog.CurrentInstance.IsPrimary && Security.IsAdministrator && BlogConfig.UsageScenario == "multiblogs")
            {
                    <li data-ng-class="{ active: isActive('/content/blogs')}"><a href="{{SiteVars.RelativeWebRoot}}admin/#/content/blogs">@Utils.Translate("blogs")</a></li>
                }
            </ul>
        </li>
        @if (Security.IsAuthorizedTo(Rights.ManageExtensions))
        {
            <li id="mu-custom">
                <a href="{{SiteVars.RelativeWebRoot}}admin/#/custom/themes"><i class="fa fa-sliders"></i> @Utils.Translate("custom")</a>
                <ul class="sub-nav-sidebar">
                    <li data-ng-class="{ active: isActive('/custom/themes')}"><a class="ng-binding" href="{{SiteVars.RelativeWebRoot}}admin/#/custom/themes">@Utils.Translate("themes")</a></li>
                    <li data-ng-class="{ active: isActive('/custom/plugins')}"><a class="ng-binding" href="{{SiteVars.RelativeWebRoot}}admin/#/custom/plugins">@Utils.Translate("plugins")</a></li>
                    <li data-ng-class="{ active: isActive('/custom/widgets')}"><a class="ng-binding" href="{{SiteVars.RelativeWebRoot}}admin/#/custom/widgets">@Utils.Translate("widgets")</a></li>
                </ul>
            </li>
        }
        @if (BlogConfig.UsageScenario == "multiusers")
        {
            <li id="mu-users">
                <a href="{{SiteVars.RelativeWebRoot}}admin/#/security/profile"><i class="fa fa-user"></i> @Utils.Translate("users")</a>
                <ul class="sub-nav-sidebar">
                    <li data-ng-class="{ active: isActive('/security/profile')}"><a class="ng-binding" href="{{SiteVars.RelativeWebRoot}}admin/#/security/profile">@Utils.Translate("profile")</a></li>
                    @if (Security.IsAuthorizedTo(Rights.ViewRoles))
                {
                        <li data-ng-class="{ active: isActive('/security/roles')}"><a class="ng-binding" href="{{SiteVars.RelativeWebRoot}}admin/#/security/roles">@Utils.Translate("roles")</a></li>
                    }
                    @if (Security.IsAuthorizedTo(Rights.EditOtherUsers))
                {
                        <li data-ng-class="{ active: isActive('/security/users')}"><a class="ng-binding" href="{{SiteVars.RelativeWebRoot}}admin/#/security/users">@Utils.Translate("users")</a></li>
                    }
                </ul>
            </li>
        }
        @if (Security.IsAuthorizedTo(Rights.AccessAdminSettingsPages))
        {
            <li id="mu-settings">
                <a href="{{SiteVars.RelativeWebRoot}}admin/#/settings/basic"><i class="fa fa-cog"></i> @Utils.Translate("settings")</a>
                <ul class="sub-nav-sidebar">
                    <li data-ng-class="{ active: isActive('/settings/basic')}"><a class="ng-binding" href="{{SiteVars.RelativeWebRoot}}admin/#/settings/basic">@Utils.Translate("basic")</a></li>
                    <li data-ng-class="{ active: isActive('/settings/email')}"><a class="ng-binding" href="{{SiteVars.RelativeWebRoot}}admin/#/settings/email">@Utils.Translate("email")</a></li>
                    <li data-ng-class="{ active: isActive('/settings/feed')}"><a class="ng-binding" href="{{SiteVars.RelativeWebRoot}}admin/#/settings/feed">@Utils.Translate("feed")</a></li>
                    <li data-ng-class="{ active: isActive('/settings/comments')}"><a class="ng-binding" href="{{SiteVars.RelativeWebRoot}}admin/#/settings/comments">@Utils.Translate("comments")</a></li>
                    <li data-ng-class="{ active: isActive('/settings/controls')}"><a class="ng-binding" href="{{SiteVars.RelativeWebRoot}}admin/#/settings/controls">@Utils.Translate("controls")</a></li>
                    @if (BlogConfig.UsageScenario != "singleblog" && Blog.CurrentInstance.IsPrimary)
                {
                        <li data-ng-class="{ active: isActive('/settings/advanced')}"><a class="ng-binding" href="{{SiteVars.RelativeWebRoot}}admin/#/settings/advanced">@Utils.Translate("advanced")</a></li>
                    }
                </ul>
            </li>
        }
        <li id="mu-about"><a href="{{SiteVars.RelativeWebRoot}}admin/about.cshtml"><i class="fa fa-info-circle"></i>@Utils.Translate("about")</a></li>
    </ul>
</div>
<div class="logo-sidebar">
    <a href="https://blogengine.io/" target="_blank" title="BlogEngine.NET - Version @BlogSettings.Instance.Version()"><img src="~/admin/themes/standard/img/logo-sidebar.png" alt="BlogEngine.NET" /></a>
</div>