@using System.Text.Encodings.Web
@{
    // Authorization (Rights.AccessAdminPages) is enforced by AdminPageModel before the page renders.
    var js = JavaScriptEncoder.Default;
    var userRights = string.Join("','", Security.CurrentUserRights().Select(r => r.Flag.ToString()));
}
<!DOCTYPE html>
<html ng-app="blogAdmin">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <title>@BlogSettings.Instance.Name (@Security.CurrentMembershipUser?.UserName)</title>
    <link href="https://fonts.googleapis.com/css?family=Roboto:400,500,700" rel="stylesheet">
    @await Html.PartialAsync("~/admin/Shared/_AdminStyles.cshtml")
    <link href="~/admin/themes/standard/css/styles.css?ver=4" rel="stylesheet">
    <link rel="shortcut icon" href="@(Utils.ApplicationRelativeWebRoot)Content/images/blog/blogengine.ico" type="image/x-icon" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="format-detection" content="telephone=no" />
    <script type="text/javascript">
        var UserVars = { Name: '@Html.Raw(js.Encode(Security.CurrentUser.Identity.Name ?? string.Empty))', IsAdmin: '@Security.IsAdministrator', Rights: ['@Html.Raw(userRights)'] };
        var ActiveTheme = '@Html.Raw(js.Encode(BlogSettings.Instance.Theme ?? string.Empty))'
        var UsageScenario = '@BlogConfig.UsageScenario'
        var ServerTime = '@DateTime.Now'
        var UtcTime = '@DateTime.UtcNow'
        if (navigator.userAgent.match(/IEMobile\/10\.0/)) {
            var msViewportStyle = document.createElement("style");
            var mq = "@@-ms-viewport{width:auto!important}";
            msViewportStyle.appendChild(document.createTextNode(mq));
            document.getElementsByTagName("head")[0].appendChild(msViewportStyle);
        }
    </script>
</head>
<body class="@Utils.Translate("LangDirection")-dir">
    <script type="text/javascript" src="@(Utils.RelativeWebRoot)admin.res.axd"></script>
    <div class="main-wrapper">
        <div class="main-sidebar">
            @await Html.PartialAsync("~/admin/themes/standard/sidebar.cshtml")
        </div>
        <div class="main-content">
            @RenderBody()
        </div>
        <div class="main-overlay"></div>
    </div>
    <script>
        $(".sidebar-toggle").click(function () {
            $(".main-wrapper").toggleClass("sidebar-open");
        });
        $(".main-overlay").click(function () {
            $(".main-wrapper").removeClass("sidebar-open");
        });

        $(".sub-nav-sidebar li").click(function () {
            $(".main-wrapper").removeClass("sidebar-open");
        });

        $(window).resize(function () {
            if ($(window).width() > 1025) {
                $(".main-wrapper").removeClass("sidebar-open");
            }
        });

    </script>
</body>
</html>
